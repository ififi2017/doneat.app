---
import ContentArticle from "../../components/ContentArticle.astro";
import LocaleBounce from "../../components/LocaleBounce.astro";
import {
  CONTENT_PAGES,
  HALL_LOCALES,
  contentLocaleFor,
  isContentLocale,
  isContentPage,
  isHallLocale,
} from "../../lib/config";

export function getStaticPaths() {
  return HALL_LOCALES.flatMap((lang) =>
    CONTENT_PAGES.map((page) => ({ params: { lang, page } })),
  );
}

const langParam = Astro.params.lang;
const pageParam = Astro.params.page;
if (!isHallLocale(langParam) || !isContentPage(pageParam)) {
  throw new Error(`Unknown content route: ${langParam}/${pageParam}`);
}

const contentLocale = isContentLocale(langParam) ? langParam : null;
const bounceTo = contentLocale ? null : contentLocaleFor(langParam);
const bounceHref = bounceTo ? `/${bounceTo}/${pageParam}` : "";
const bounceScript = bounceTo
  ? `(function(){location.replace(${JSON.stringify(bounceHref)}+location.search+location.hash);})();`
  : "";
---

{
  contentLocale ? (
    <ContentArticle locale={contentLocale} page={pageParam} />
  ) : (
    <LocaleBounce
      script={bounceScript}
      links={[{ href: bounceHref, label: bounceTo === "zh-CN" ? "中文" : "English" }]}
    />
  )
}
