---
import { getCollection } from "astro:content";
import ContentArticle from "../../components/ContentArticle.astro";
import { isContentPage, isHallLocale } from "../../lib/config";

export async function getStaticPaths() {
  const entries = await getCollection("pages");
  return entries.flatMap((entry) => {
    const [lang, page] = entry.id.split("/");
    if (!isHallLocale(lang) || !isContentPage(page)) return [];
    return [{ params: { lang, page } }];
  });
}

const langParam = Astro.params.lang;
const pageParam = Astro.params.page;
if (!isHallLocale(langParam) || !isContentPage(pageParam)) {
  throw new Error(`Unknown content route: ${langParam}/${pageParam}`);
}
---

<ContentArticle locale={langParam} page={pageParam} />
