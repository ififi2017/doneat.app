---
import { Picture } from "astro:assets";
import BrandMark from "../../components/BrandMark.astro";
import DeviceHero from "../../components/DeviceHero.astro";
import MediaControls from "../../components/MediaControls.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StoreEntries from "../../components/StoreEntries.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { brandSentence, contentLocaleFor, functionalSubtitle, HALL_LOCALES, homeTitle, isChineseHall, isHallLocale, t, webAppUrl } from "../../lib/config";
import { homeJsonLd } from "../../lib/jsonld";
import { homeStory } from "../../lib/home-story";
import { heroLineWidth } from "../../lib/hero-title";
import "../../styles/home-story.css";
import enWidgets from "../../../assets/showcase/en/iphone-widgets.webp";
import enWatch from "../../../assets/showcase/en/iphone-watch.webp";
import zhWidgets from "../../../assets/showcase/zh-CN/iphone-widgets.webp";
import zhWatch from "../../../assets/showcase/zh-CN/iphone-watch.webp";

export function getStaticPaths() { return HALL_LOCALES.map((lang) => ({ params: { lang } })); }
const locale = Astro.params.lang;
if (!isHallLocale(locale)) throw new Error(`Unknown hall locale: ${locale}`);
const copy = homeStory(locale);
// Keep the following comma with the Chinese noun.
const getTitleParts = isChineseHall(locale) ? copy.getTitle.split(/(时间，|時間，)/u) : [copy.getTitle];
const description = t(locale, "homeDescription");
const download = `/${contentLocaleFor(locale)}/download`;
const widgets = isChineseHall(locale) ? zhWidgets : enWidgets;
const watch = isChineseHall(locale) ? zhWatch : enWatch;
const values = [t(locale, "valueLocal"), t(locale, "valueNoAccount"), t(locale, "valueSeeDone")];
---

<BaseLayout locale={locale} title={homeTitle(locale)} description={description} path={`/${locale}`} hreflangKind="hall" jsonLd={homeJsonLd({locale,description})} trackPage="hall_view">
  <div class="shift-page">
    <SiteHeader locale={locale} currentPage="home" />
    <main id="content">
      <section class="shift-hero" aria-labelledby="shift-title">
        <div class="shift-frame">
          <div class="shift-masthead"><span>DoneAt — {functionalSubtitle(locale)}</span><a href="#see-it">{copy.explore}<span aria-hidden="true">↓</span></a></div>
          <h1 class="shift-title" id="shift-title" style={`--hero-line-width:${heroLineWidth(locale)}`}><span>{copy.headlineWork}</span><span>{copy.headlineLife}</span></h1>
          <div class="shift-bottom">
            <div class="shift-intro"><p>{brandSentence(locale)}</p><div class="shift-actions"><a class="btn btn-primary" href={download} data-track="download_page_open">{t(locale,"downloadCta")}</a><a class="shift-web-link" href={webAppUrl(locale,"hall")} target="_blank" rel="noopener noreferrer" data-track="web_timer_open">{t(locale,"webCta")}<span aria-hidden="true">↗</span></a></div></div>
            <figure class="shift-ticket" dir="ltr" aria-label={copy.shiftExample}>
              <div class="ticket-label"><span dir="auto">{copy.clockIn}</span><span dir="auto">{copy.clockOut}</span></div>
              <div class="ticket-hours"><span>09:00</span><svg viewBox="0 0 160 30" aria-hidden="true"><path d="M0 15H152m-14-13 14 13-14 13" fill="none" stroke="currentColor" stroke-width="2" /></svg><span>17:00</span></div>
              <figcaption><span dir="auto">{copy.shiftExample}</span><span class="ticket-punch" aria-hidden="true"></span></figcaption>
            </figure>
          </div>
        </div>
        <div class="shift-cut" aria-hidden="true"><span>DoneAt</span><span>→</span></div>
      </section>
      <section class="shift-proof shift-frame" id="see-it" aria-labelledby="proof-title">
        <div class="chapter-line"><span>01</span><span>{functionalSubtitle(locale)}</span><MediaControls locale={locale} /></div>
        <div class="proof-layout">
          <div class="proof-copy"><h2 id="proof-title">{copy.proofTitle}</h2><p>{copy.proofBody}</p><ul class="proof-values">{values.map((v,i)=><li><span aria-hidden="true">0{i+1}</span>{v}</li>)}</ul><a class="story-link" href={download}>{t(locale,"downloadCta")}<span aria-hidden="true">↗</span></a></div>
          <figure class="proof-device"><div class="proof-label"><BrandMark locale={locale} /><span>DoneAt</span></div><DeviceHero locale={locale} /><figcaption>{copy.recording}</figcaption></figure>
        </div>
      </section>
      <section class="shift-carry" aria-labelledby="carry-title">
        <div class="shift-frame"><div class="chapter-line"><span>02</span><span>iPhone · iPad · Apple Watch</span></div><div class="carry-heading"><h2 id="carry-title">{copy.carryTitle}</h2><p>{copy.carryBody}</p></div>
          <div class="carry-gallery"><figure><Picture src={widgets} formats={["webp"]} widths={[360,720]} sizes="(min-width:880px) 30vw, 80vw" alt={copy.widgetsAlt} loading="lazy" decoding="async" /><figcaption>iPhone / iPad</figcaption></figure><div class="carry-divider" aria-hidden="true"><span>→</span><svg viewBox="0 0 160 160" fill="none"><circle cx="80" cy="80" r="74" stroke="currentColor" stroke-width="1" /><path d="M80 42V80L104 98" stroke="currentColor" stroke-width="5" stroke-linecap="round" /></svg><span>↗</span></div><figure><Picture src={watch} formats={["webp"]} widths={[360,720]} sizes="(min-width:880px) 30vw, 80vw" alt={copy.watchAlt} loading="lazy" decoding="async" /><figcaption>Apple Watch</figcaption></figure></div>
        </div>
      </section>
      <section class="shift-get shift-frame" id="get-doneat" aria-labelledby="get-title"><div class="chapter-line"><span>03</span><span>DoneAt</span></div><div class="get-layout"><h2 id="get-title">{getTitleParts.map(part => part === "时间，" || part === "時間，" ? <span class="get-title-word">{part}</span> : part)}</h2><div><p>{copy.getBody}</p><StoreEntries locale={locale} /><p class="get-android">Android — {t(locale,"comingSoon")}</p></div></div></section>
    </main>
    <SiteFooter locale={locale} />
  </div>
</BaseLayout>

<script>
  const title = document.getElementById("shift-title");
  if (title instanceof HTMLElement) {
    const rows = Array.from(title.querySelectorAll<HTMLElement>(":scope > span"));
    let frame = 0;
    let observedWidth = -1;

    // Correct only actual overflow from a substituted system font; never hide text.
    function fitTitle() {
      if (!(title instanceof HTMLElement)) return;
      title.style.removeProperty("--hero-font-fit");
      const available = title.getBoundingClientRect().width - 1;
      if (available <= 0) return;
      let size = parseFloat(getComputedStyle(title).fontSize);
      for (let attempt = 0; attempt < 3; attempt++) {
        const widest = Math.max(...rows.map(row => row.getBoundingClientRect().width));
        if (widest <= available) break;
        size *= available / widest;
        title.style.setProperty("--hero-font-fit", `${Math.floor(size * 10) / 10}px`);
      }
    }

    function scheduleFit() {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(fitTitle);
    }

    fitTitle();
    document.fonts.ready.then(scheduleFit);
    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(entries => {
        const width = entries[0]?.contentRect.width ?? 0;
        if (Math.abs(width - observedWidth) < 0.5) return;
        observedWidth = width;
        scheduleFit();
      }).observe(title);
    } else {
      window.addEventListener("resize", scheduleFit, { passive: true });
    }
  }
</script>
