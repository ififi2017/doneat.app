---
import BrandMark from "../../components/BrandMark.astro";
import DeviceHero from "../../components/DeviceHero.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StoreEntries from "../../components/StoreEntries.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  brandSentence,
  functionalSubtitle,
  HALL_LOCALES,
  homeTitle,
  isHallLocale,
  sameAsUrls,
  siteConfig,
  t,
  type HallLocale,
} from "../../lib/config";

export function getStaticPaths() {
  return HALL_LOCALES.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
if (!isHallLocale(langParam)) {
  throw new Error(`Unknown hall locale: ${langParam}`);
}
const locale: HallLocale = langParam;
const sentence = brandSentence(locale);
const subtitle = functionalSubtitle(locale);
const description = t(locale, "homeDescription");
const values = [
  t(locale, "valueLocal"),
  t(locale, "valueNoAccount"),
  t(locale, "valueSeeDone"),
] as const;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.brandName,
  url: siteConfig.officialSiteUrl,
  logo: `${siteConfig.officialSiteUrl}/icons/icon-512.png`,
  email: siteConfig.supportEmail,
  sameAs: sameAsUrls(),
};
---

<BaseLayout
  locale={locale}
  title={homeTitle(locale)}
  description={description}
  path={`/${locale}`}
  hreflangKind="hall"
  jsonLd={jsonLd}
  trackPage="hall_view"
>
  <div class="hall-page flex min-h-dvh flex-col">
    <SiteHeader locale={locale} currentPage="home" />
    <main id="content" class="page-frame hall">
      <div class="hall-copy">
        <BrandMark class="hall-mark" />
        <p class="hall-eyebrow">{subtitle}</p>
        <h1 class="hall-title">DoneAt</h1>
        {sentence ? <p class="hall-lede">{sentence}</p> : null}
        <div class="hall-cta">
          <StoreEntries locale={locale} variant="home" />
        </div>
        <p class="hall-qualities">
          {values.map((value) => <span>{value}</span>)}
        </p>
      </div>
      <div class="hall-stage">
        <DeviceHero locale={locale} priority />
      </div>
    </main>
    <SiteFooter locale={locale} />
  </div>
</BaseLayout>
