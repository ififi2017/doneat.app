---
import BrandMark from "../../components/BrandMark.astro";
import DeviceHero from "../../components/DeviceHero.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StoreEntries from "../../components/StoreEntries.astro";
import MediaControls from "../../components/MediaControls.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  brandSentence,
  functionalSubtitle,
  HALL_LOCALES,
  homeTitle,
  isHallLocale,
  t,
  type HallLocale,
} from "../../lib/config";
import { homeJsonLd } from "../../lib/jsonld";

export function getStaticPaths() {
  return HALL_LOCALES.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
if (!isHallLocale(langParam)) {
  throw new Error(`Unknown hall locale: ${langParam}`);
}
const locale: HallLocale = langParam;
const sentence = brandSentence(locale);
const subtitle = functionalSubtitle(locale);
const description = t(locale, "homeDescription");
const values = [
  t(locale, "valueLocal"),
  t(locale, "valueNoAccount"),
  t(locale, "valueSeeDone"),
] as const;

const jsonLd = homeJsonLd({ locale, description });
---

<BaseLayout
  locale={locale}
  title={homeTitle(locale)}
  description={description}
  path={`/${locale}`}
  hreflangKind="hall"
  jsonLd={jsonLd}
  trackPage="hall_view"
>
  <div class="hall-page flex min-h-dvh flex-col">
    <SiteHeader locale={locale} currentPage="home" />
    <main id="content" class="page-frame hall">
      <div class="hall-copy">
        <div class="hall-signature">
          <BrandMark class="hall-mark" locale={locale} />
          <p class="hall-eyebrow">{subtitle}</p>
        </div>
        <h1 class="hall-title">DoneAt</h1>
        {sentence ? <p class="hall-lede">{sentence}</p> : null}
        <div class="hall-cta">
          <StoreEntries locale={locale} variant="home" />
        </div>
        <p class="hall-qualities" data-hall-qualities>
          {values.map((value, index) => <span><small aria-hidden="true">0{index + 1}</small>{value}</span>)}
        </p>
      </div>
      <div class="hall-stage">
        <div class="daylight-dial" aria-hidden="true">
          <svg viewBox="0 0 600 600" fill="none">
            <circle class="dial-orbit" cx="300" cy="300" r="264" />
            <circle class="dial-inner" cx="300" cy="300" r="220" />
            {Array.from({length: 60}, (_, i) => <path class:list={["dial-tick", i % 5 === 0 && "is-hour"]} d={i % 5 === 0 ? "M300 25V43" : "M300 29V36"} transform={`rotate(${i * 6} 300 300)`} />)}
            <path class="dial-day" d="M300 36 A264 264 0 0 1 432 529" />
            <circle class="dial-end" cx="432" cy="529" r="7" />
          </svg>
        </div>
        <div class="hall-device"><DeviceHero locale={locale} priority /></div>
        <div class="hall-stage-caption"><span>{t(locale, "deviceAlt")}</span><MediaControls locale={locale} /></div>
      </div>
    </main>
    <SiteFooter locale={locale} />
  </div>
</BaseLayout>
