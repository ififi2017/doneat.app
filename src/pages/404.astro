---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  HALL_LOCALES,
  siteConfig,
  t,
  type HallLocale,
} from "../lib/config";
import { notFoundApplyInlineScript, type NotFoundCopy } from "../lib/locale";

const copy = Object.fromEntries(
  HALL_LOCALES.map((locale) => [
    locale,
    {
      title: t(locale, "notFoundTitle"),
      heading: t(locale, "notFoundHeading"),
      body: t(locale, "notFoundBody"),
      home: t(locale, "notFoundHome"),
      timer: t(locale, "webCta"),
    } satisfies NotFoundCopy,
  ]),
) as Record<HallLocale, NotFoundCopy>;

const fallback = copy.en;
const applyScript = notFoundApplyInlineScript(copy, siteConfig.webAppUrl);
---

<BaseLayout
  locale="en"
  title={fallback.title}
  description={fallback.body}
  path="/en"
  hreflangKind="hall"
  noindex
>
  <div class="flex min-h-screen flex-col">
    <header
      class="sticky top-0 z-40 border-b border-plum/10 bg-cream/90 pt-[env(safe-area-inset-top)] backdrop-blur-md dark:border-cream/10 dark:bg-evening-end/80"
    >
      <div class="page-frame flex items-center py-1.5 sm:py-3">
        <a
          id="nf-logo"
          href="/en"
          class="flex shrink-0 items-center gap-2 no-underline"
        >
          <img
            class="h-7 w-7 sm:h-8 sm:w-8 dark:hidden"
            src="/brand/off-work-countdown-mark.svg"
            width="32"
            height="32"
            alt=""
          />
          <img
            class="hidden h-7 w-7 sm:h-8 sm:w-8 dark:block"
            src="/brand/off-work-countdown-mark-dark.svg"
            width="32"
            height="32"
            alt=""
          />
          <span class="text-base font-semibold tracking-tight">DoneAt</span>
        </a>
      </div>
    </header>

    <main
      id="content"
      class="mx-auto flex w-full max-w-xl flex-1 flex-col justify-center px-4 py-16 sm:px-6 sm:py-24"
    >
      <img
        class="h-16 w-16 dark:hidden sm:h-20 sm:w-20"
        src="/brand/off-work-countdown-mark.svg"
        width="80"
        height="80"
        alt=""
      />
      <img
        class="hidden h-16 w-16 dark:block sm:h-20 sm:w-20"
        src="/brand/off-work-countdown-mark-dark.svg"
        width="80"
        height="80"
        alt=""
      />
      <p class="mt-6 text-sm font-medium text-orange-ink dark:text-orange-bright">404</p>
      <h1
        id="nf-heading"
        class="mt-2 text-[1.75rem] font-semibold tracking-tight sm:text-4xl"
      >
        {fallback.heading}
      </h1>
      <p
        id="nf-body"
        class="mt-4 max-w-md text-base leading-relaxed text-plum/80 dark:text-cream/80"
      >
        {fallback.body}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a id="nf-home" href="/en" class="btn btn-primary">
          {fallback.home}
        </a>
        <a
          id="nf-timer"
          href={siteConfig.webAppUrl + "/en"}
          class="btn btn-secondary"
          data-track="web_timer_open"
          target="_blank"
          rel="noopener noreferrer"
        >
          {fallback.timer}
        </a>
      </div>
      <Fragment set:html={`<script>${applyScript}</script>`} />
    </main>

    <footer class="mt-auto border-t border-plum/10 dark:border-cream/10">
      <div
        class="page-frame flex py-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] text-sm sm:py-6 sm:pb-[max(1.5rem,env(safe-area-inset-bottom))]"
      >
        <a
          class="text-plum/80 hover:text-orange-ink dark:text-cream/80 dark:hover:text-orange-bright"
          href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a
        >
      </div>
    </footer>
  </div>
</BaseLayout>
