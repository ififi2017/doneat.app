---
import LocaleBounce from "../components/LocaleBounce.astro";
import { CONTENT_PAGES, isContentPage, localeNames, publishedLocalesFor } from "../lib/config";
import { contentPageRedirectInlineScript } from "../lib/locale";

export function getStaticPaths() {
  return CONTENT_PAGES.map((page) => ({ params: { page } }));
}

const pageParam = Astro.params.page;
if (!isContentPage(pageParam)) {
  throw new Error(`Unknown content slug: ${pageParam}`);
}
---

<LocaleBounce
  script={contentPageRedirectInlineScript(pageParam)}
  links={publishedLocalesFor(pageParam).map((code) => ({
    href: `/${code}/${pageParam}`,
    label: localeNames[code],
  }))}
/>
