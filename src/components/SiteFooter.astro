---
import SocialLinks from "./SocialLinks.astro";
import {
  contentLocaleFor,
  siteConfig,
  t,
  type HallLocale,
} from "../lib/config";

interface Props {
  locale: HallLocale;
}

const { locale } = Astro.props;
const contentLang = contentLocaleFor(locale);
---

<footer class="site-footer mt-auto border-t border-plum/10 dark:border-cream/10">
  <div class="page-frame site-footer-inner">
    <nav class="site-footer-nav" aria-label={siteConfig.brandName}>
      <a href={`/${contentLang}/how-it-works`}>{t(locale, "howItWorks")}</a>
      <a href={`/${contentLang}/privacy`}>{t(locale, "privacy")}</a>
      <a href={`mailto:${siteConfig.supportEmail}`}>{t(locale, "contactUs")}</a>
    </nav>
    <div class="site-footer-end">
      <SocialLinks locale={locale} />
      <p class="site-footer-credits">
        <a href="https://rainif.com" target="_blank" rel="noopener noreferrer">
          © fi_niaR Studio
        </a>
        <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">
          Powered by Astro
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 0.5rem 1.25rem;
    padding-block: 0.85rem 1rem;
    padding-bottom: max(1rem, env(safe-area-inset-bottom));
    font-size: 0.875rem;
  }

  .site-footer-nav,
  .site-footer-end,
  .site-footer-credits {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }

  .site-footer-end {
    margin-inline: auto 0;
  }

  .site-footer-credits {
    margin-block: 0;
  }

  @media (max-width: 639px) {
    .site-footer-inner {
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 0.45rem;
    }

    .site-footer-nav,
    .site-footer-end,
    .site-footer-credits {
      justify-content: center;
      margin-inline: 0;
    }

    .site-footer-end {
      flex-direction: column;
      gap: 0.2rem;
    }
  }

  .site-footer-inner a {
    color: color-mix(in srgb, var(--color-plum) 80%, transparent);
    text-decoration: none;
  }

  .site-footer-inner a:hover {
    color: var(--color-orange-ink);
  }

  @media (prefers-color-scheme: dark) {
    .site-footer-inner a {
      color: color-mix(in srgb, var(--color-cream) 80%, transparent);
    }

    .site-footer-inner a:hover {
      color: var(--color-orange-bright);
    }
  }
</style>
