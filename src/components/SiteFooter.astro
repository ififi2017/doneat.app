---
import {
  contentLocaleFor,
  siteConfig,
  t,
  type HallLocale,
} from "../lib/config";

interface Props {
  locale: HallLocale;
}

const { locale } = Astro.props;
const contentLang = contentLocaleFor(locale);
---

<footer class="mt-auto border-t border-plum/10 dark:border-cream/10">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] text-sm sm:gap-x-5 sm:px-6 sm:py-6 sm:pb-[max(1.5rem,env(safe-area-inset-bottom))]"
  >
    <a
      class="text-plum/80 hover:text-orange-ink dark:text-cream/80 dark:hover:text-orange-bright"
      href={`/${contentLang}/how-it-works`}>{t(locale, "howItWorks")}</a
    >
    <a
      class="text-plum/80 hover:text-orange-ink dark:text-cream/80 dark:hover:text-orange-bright"
      href={`/${contentLang}/privacy`}>{t(locale, "privacy")}</a
    >
    <a
      class="text-plum/80 hover:text-orange-ink dark:text-cream/80 dark:hover:text-orange-bright"
      href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a
    >
    <a
      class="text-plum/80 hover:text-orange-ink dark:text-cream/80 dark:hover:text-orange-bright"
      href={siteConfig.githubUrl}>{t(locale, "source")}</a
    >
  </div>
</footer>
