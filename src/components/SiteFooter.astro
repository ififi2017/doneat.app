---
import SocialLinks from "./SocialLinks.astro";
import {
  contentLocaleFor,
  icpFilingNumber,
  otherSiteLink,
  psbFilingNumber,
  psbFilingUrl,
  siteConfig,
  t,
  type HallLocale,
} from "../lib/config";

interface Props {
  locale: HallLocale;
}

const { locale } = Astro.props;
const howItWorksLang = contentLocaleFor(locale, "how-it-works");
const privacyLang = contentLocaleFor(locale, "privacy");
const otherSite = otherSiteLink(Astro.url.pathname.replace(/\/$/, ""));
---

<footer class="site-footer mt-auto">
  <div class="page-frame site-footer-inner">
    <nav class="site-footer-nav" aria-label={siteConfig.brandName}>
      <a href={`/${howItWorksLang}/how-it-works`}>{t(locale, "howItWorks")}</a>
      <a href={`/${privacyLang}/privacy`}>{t(locale, "privacy")}</a>
      <a href={`mailto:${siteConfig.supportEmail}`}>{t(locale, "contactUs")}</a>
      {otherSite && <a href={otherSite.href} lang="zh-CN">{otherSite.label}</a>}
    </nav>
    <div class="site-footer-end">
      <SocialLinks locale={locale} />
      <p class="site-footer-credits">
        <a class="studio-mark" href="https://finiar.app" target="_blank" rel="noopener noreferrer" aria-label="© fi_niaR Studio">
          ©&nbsp;<span class="studio-mark-chevron" aria-hidden="true">&gt;</span>fi_niaR Studio<span class="studio-mark-cursor" aria-hidden="true"></span>
        </a>
        {icpFilingNumber && <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{icpFilingNumber}</a>}
        {psbFilingNumber && <a href={psbFilingUrl} target="_blank" rel="noopener noreferrer">{psbFilingNumber}</a>}
        <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">
          Powered by Astro
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --footer-link-color: var(--night-ink);
    --footer-link-hover-color: var(--color-orange-bright);
    --accent: var(--color-orange-bright);
    background: var(--night-surface);
    color: var(--night-ink);
    border-top: 1px solid color-mix(in srgb, var(--night-ink) 22%, transparent);
  }
  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    padding-block: 1.5rem;
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    font-size: 0.75rem;
  }

  .site-footer-nav,
  .site-footer-end,
  .site-footer-credits {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }

  .site-footer-end {
    margin-inline: auto 0;
  }

  .site-footer-credits {
    margin-block: 0;
  }

  /* fi_niaR Studio mark, shared with finiar.app and the other studio sites.
     The font is a Geist Mono Bold subset holding only "> fi_niaR Studio"
     (OFL-1.1, public/licenses/geist-ofl.txt). The footer is always dark, so
     the mark uses the studio's dark-scheme accent. */
  @font-face {
    font-family: "fi_niaR Mark";
    src: url("/fonts/fi_niaR-Mark.woff2") format("woff2");
    font-weight: 700;
    font-display: swap;
  }

  .site-footer-inner .studio-mark {
    font: 700 1em/1 "fi_niaR Mark", "Geist Mono", ui-monospace, "SF Mono", Menlo, monospace;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .studio-mark-chevron {
    color: #7aa7ff;
    margin-right: 0.4em;
  }

  .studio-mark-cursor {
    display: inline-block;
    width: 0.55em;
    height: 0.95em;
    margin-left: 0.15em;
    background: #7aa7ff;
    opacity: 0.85;
    animation: studio-mark-blink 1.1s step-end infinite;
  }

  @keyframes studio-mark-blink {
    0%, 49% { opacity: 0.85; }
    50%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .studio-mark-cursor { animation: none; }
  }

  @media (max-width: 639px) {
    .site-footer-inner {
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 0.45rem;
    }

    .site-footer-nav,
    .site-footer-end,
    .site-footer-credits {
      justify-content: center;
      margin-inline: 0;
    }

    .site-footer-end {
      flex-direction: column;
      gap: 0.2rem;
    }
  }

  .site-footer-inner a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--footer-link-color, color-mix(in srgb, var(--color-plum) 80%, transparent));
    text-decoration: none;
  }

  .site-footer-inner a:hover {
    color: var(--footer-link-hover-color, var(--color-orange-ink));
  }

  @media (prefers-color-scheme: dark) {
    .site-footer-inner a {
      color: var(--footer-link-color, color-mix(in srgb, var(--color-cream) 80%, transparent));
    }

    .site-footer-inner a:hover {
      color: var(--footer-link-hover-color, var(--color-orange-bright));
    }
  }
</style>
