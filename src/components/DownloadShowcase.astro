---
import { Picture } from "astro:assets";
import DeviceHero from "./DeviceHero.astro";
import DesktopClip from "./DesktopClip.astro";
import {
  desktopMediaStem,
  downloadShowcaseCopy,
} from "../lib/download-showcase";
import type { ContentLocale } from "../lib/config";
import enCalendar from "../../assets/showcase/en/iphone-calendar.webp";
import enCountdown from "../../assets/showcase/en/iphone-countdown.webp";
import enWatch from "../../assets/showcase/en/iphone-watch.webp";
import enWidgets from "../../assets/showcase/en/iphone-widgets.webp";
import zhCalendar from "../../assets/showcase/zh-CN/iphone-calendar.webp";
import zhCountdown from "../../assets/showcase/zh-CN/iphone-countdown.webp";
import zhWatch from "../../assets/showcase/zh-CN/iphone-watch.webp";
import zhWidgets from "../../assets/showcase/zh-CN/iphone-widgets.webp";

interface Props {
  locale: ContentLocale;
}

const { locale } = Astro.props;
const copy = downloadShowcaseCopy(locale);
const stem = desktopMediaStem(locale);
// 3.2.0 iPhone 商店图（产品仓 scripts/marketing-shots/ios/out/creative-3.2.0，按 720 宽导出）。
const shots =
  locale === "zh-CN"
    ? { countdown: zhCountdown, widgets: zhWidgets, calendar: zhCalendar, watch: zhWatch }
    : { countdown: enCountdown, widgets: enWidgets, calendar: enCalendar, watch: enWatch };
---

<section class="showcase" aria-labelledby="download-showcase">
  <h2 id="download-showcase" class="article-block-title">{copy.heading}</h2>
  <p class="article-sublede">{copy.lede}</p>

  <div class="showcase-stages">
    <figure class="showcase-figure">
      <DeviceHero locale={locale} clip="review" alt={copy.reviewAlt} />
      <figcaption>{copy.mobileCaption}</figcaption>
    </figure>
    <div class="showcase-desk">
      <figure class="showcase-figure">
        <DesktopClip stem={stem} kind="app" alt={copy.appAlt} />
        <figcaption>{copy.desktopCaption}</figcaption>
      </figure>
      <figure class="showcase-figure">
        <DesktopClip stem={stem} kind="mini" alt={copy.miniAlt} />
        <figcaption>{copy.miniCaption}</figcaption>
      </figure>
    </div>
  </div>

  <!-- 一个图位轮播四张商店图；四段说明始终可见（图上的标题搜索引擎读不到）。
       没有脚本时停在第一张；减少动态效果时不自动轮播，点选仍可切换。 -->
  <section class="tour" aria-labelledby="download-iphone" data-iphone-tour>
    <h2 id="download-iphone" class="article-block-title showcase-compare-title">
      {copy.iphoneHeading}
    </h2>
    <p class="article-sublede">{copy.iphoneLede}</p>
    <div class="tour-stage">
      <div class="tour-slot">
        {
          copy.iphoneFeatures.map((feature, index) => (
            <Picture
              src={shots[feature.shot]}
              alt={feature.alt}
              formats={["webp"]}
              fallbackFormat="webp"
              widths={[360, 720]}
              sizes="(min-width: 880px) 15rem, 60vw"
              loading="lazy"
              decoding="async"
              pictureAttributes={{
                class: "tour-shot",
                "data-tour-shot": String(index),
                "data-active": index === 0 ? "" : undefined,
                "aria-hidden": index === 0 ? undefined : "true",
              }}
            />
          ))
        }
      </div>
      <ol class="tour-list">
        {
          copy.iphoneFeatures.map((feature, index) => (
            <li class="tour-item" data-tour-item={index} data-active={index === 0 ? "" : undefined}>
              <span class="tour-dot" aria-hidden="true" />
              <div>
                <h3 class="tour-title">
                  <button type="button" aria-pressed={index === 0 ? "true" : "false"}>
                    {feature.title}
                  </button>
                </h3>
                <p class="tour-body">{feature.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <h2 id="download-compare" class="article-block-title showcase-compare-title">
    {copy.comparisonHeading}
  </h2>
  <p class="article-sublede">{copy.comparisonLede}</p>

  <div class="compare-wrap" role="region" aria-labelledby="download-compare">
    <table class="compare-table">
      <thead>
        <tr>
          <th scope="col">{copy.featureLabel}</th>
          <th scope="col">{copy.mobileLabel}</th>
          <th scope="col">{copy.desktopLabel}</th>
        </tr>
      </thead>
      <tbody>
        {
          copy.rows.map((row) => (
            <tr>
              <th scope="row">{row.feature}</th>
              <td data-status={row.mobile.status}>
                <span class="compare-cell">
                  <span class="compare-cue" aria-hidden="true"></span>
                  <span>{row.mobile.detail}</span>
                </span>
              </td>
              <td data-status={row.desktop.status}>
                <span class="compare-cell">
                  <span class="compare-cue" aria-hidden="true"></span>
                  <span>{row.desktop.detail}</span>
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<script is:inline>
  (function () {
    var tour = document.querySelector("[data-iphone-tour]");
    if (!(tour instanceof HTMLElement)) return;
    var shots = tour.querySelectorAll("[data-tour-shot]");
    var items = tour.querySelectorAll("[data-tour-item]");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var active = 0;
    var visible = false;
    var held = false;
    var timer = 0;

    function show(index) {
      active = index;
      shots.forEach(function (shot, i) {
        if (i === index) {
          shot.setAttribute("data-active", "");
          shot.removeAttribute("aria-hidden");
        } else {
          shot.removeAttribute("data-active");
          shot.setAttribute("aria-hidden", "true");
        }
      });
      items.forEach(function (item, i) {
        if (i === index) item.setAttribute("data-active", "");
        else item.removeAttribute("data-active");
        var button = item.querySelector("button");
        if (button) button.setAttribute("aria-pressed", i === index ? "true" : "false");
      });
      schedule();
    }

    // 每张停留 4.5 秒；只在看得见、没有悬停或焦点、没开减少动态效果时轮播。
    function schedule() {
      window.clearTimeout(timer);
      if (reduce || held || !visible) return;
      timer = window.setTimeout(function () {
        show((active + 1) % shots.length);
      }, 4500);
    }

    items.forEach(function (item, i) {
      item.addEventListener("click", function () {
        show(i);
      });
    });
    tour.addEventListener("mouseenter", function () {
      held = true;
      schedule();
    });
    tour.addEventListener("mouseleave", function () {
      held = false;
      schedule();
    });
    tour.addEventListener("focusin", function () {
      held = true;
      schedule();
    });
    tour.addEventListener("focusout", function () {
      held = false;
      schedule();
    });

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        function (entries) {
          visible = Boolean(entries[0] && entries[0].isIntersecting);
          schedule();
        },
        { threshold: 0.4 },
      ).observe(tour.querySelector(".tour-slot"));
    }
  })();
</script>

<script is:inline>
  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;

    function loadClip(clip) {
      if (!(clip instanceof HTMLElement)) return;
      var video = clip.querySelector(dark ? "video.dark-scheme" : "video.light-scheme");
      if (reduce || !(video instanceof HTMLVideoElement) || !video.dataset.src) return;
      if (video.querySelector("source")) return;
      var source = document.createElement("source");
      source.src = video.dataset.src;
      source.type = "video/mp4";
      video.appendChild(source);
      video.setAttribute("autoplay", "");
      video.preload = "metadata";
      video.addEventListener(
        "canplay",
        function () {
          clip.classList.add("is-playing");
        },
        { once: true },
      );
      video.load();
      var play = video.play();
      if (play && typeof play.catch === "function") play.catch(function () {});
    }

    var clips = document.querySelectorAll("[data-desktop-clip]");
    if (!clips.length) return;

    if (!("IntersectionObserver" in window)) {
      clips.forEach(loadClip);
      return;
    }

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          io.unobserve(entry.target);
          loadClip(entry.target);
        });
      },
      { rootMargin: "160px 0px", threshold: 0.01 },
    );
    clips.forEach(function (clip) {
      io.observe(clip);
    });
  })();
</script>

<style>
  .showcase {
    margin-top: 2.75rem;
  }

  .showcase-stages {
    display: grid;
    gap: 2rem;
    align-items: start;
    margin: 1.75rem 0 0;
  }

  .showcase-desk {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
    max-width: 22rem;
  }

  .showcase-figure {
    margin: 0;
    min-width: 0;
  }

  .showcase-figure figcaption {
    margin-top: 0.65rem;
    color: color-mix(in srgb, var(--color-plum) 58%, transparent);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    line-height: 1.45;
  }

  .showcase-compare-title {
    margin-top: 2.75rem;
  }

  .tour-stage {
    display: grid;
    gap: 1.75rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  .tour-slot {
    position: relative;
    width: 100%;
    max-width: 15rem;
    margin-inline: auto;
    aspect-ratio: 720 / 1565;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-plum) 10%, transparent);
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--color-plum) 4%, var(--color-cream));
    box-shadow: 0 18px 40px -22px color-mix(in srgb, var(--color-plum) 45%, transparent);
  }

  .tour-slot :global(.tour-shot) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 500ms ease-out;
  }

  .tour-slot :global(.tour-shot[data-active]) {
    opacity: 1;
  }

  .tour-slot :global(.tour-shot img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tour-list {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tour-item {
    display: flex;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    border-radius: 0.9rem;
    cursor: pointer;
    transition: background-color 200ms ease;
  }

  .tour-item[data-active] {
    background: color-mix(in srgb, var(--color-plum) 4.5%, transparent);
  }

  .tour-dot {
    flex: none;
    width: 0.4rem;
    height: 0.4rem;
    margin-top: 0.55rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-plum) 22%, transparent);
    transition: background-color 200ms ease;
  }

  .tour-item[data-active] .tour-dot {
    background: var(--color-orange-ink);
  }

  .tour-title {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.45;
  }

  .tour-title button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .tour-body {
    margin: 0.3rem 0 0;
    color: color-mix(in srgb, var(--color-plum) 72%, transparent);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .compare-wrap {
    margin-top: 1.15rem;
    overflow-x: auto;
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .compare-table th,
  .compare-table td {
    padding: 0.7rem 0.75rem 0.7rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-plum) 10%, transparent);
    text-align: start;
    vertical-align: top;
  }

  .compare-table thead th {
    color: color-mix(in srgb, var(--color-plum) 55%, transparent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .compare-table tbody th {
    font-weight: 600;
    color: var(--color-plum);
  }

  .compare-cell {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .compare-cue {
    flex: none;
    box-sizing: border-box;
    margin-top: 0.42em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }

  .compare-table td[data-status="included"] {
    color: var(--color-plum);
    font-weight: 500;
  }

  .compare-table td[data-status="included"] .compare-cue {
    background: var(--color-orange-ink);
  }

  .compare-table td[data-status="limited"] {
    color: color-mix(in srgb, var(--color-plum) 58%, transparent);
    font-weight: 400;
  }

  .compare-table td[data-status="limited"] .compare-cue {
    background: transparent;
    border: 1.5px solid color-mix(in srgb, var(--color-plum) 38%, transparent);
  }

  .compare-table td[data-status="absent"] {
    color: color-mix(in srgb, var(--color-plum) 36%, transparent);
    font-weight: 400;
  }

  .compare-table td[data-status="absent"] .compare-cue {
    width: 0.5rem;
    height: 0;
    margin-top: 0.72em;
    border-radius: 0;
    border-top: 1.5px solid color-mix(in srgb, var(--color-plum) 32%, transparent);
  }

  @media (min-width: 880px) {
    .tour-stage {
      grid-template-columns: 15rem minmax(0, 36rem);
      justify-content: start;
      gap: 2.75rem;
    }

    .showcase-stages {
      grid-template-columns: 17.5rem 22rem;
      justify-content: start;
      align-items: start;
      gap: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tour-slot :global(.tour-shot),
    .tour-item,
    .tour-dot {
      transition: none;
    }
  }

  @media (prefers-color-scheme: dark) {
    .tour-slot {
      border-color: color-mix(in srgb, var(--color-cream) 12%, transparent);
      box-shadow: none;
    }

    .tour-item[data-active] {
      background: color-mix(in srgb, var(--color-cream) 6%, transparent);
    }

    .tour-dot {
      background: color-mix(in srgb, var(--color-cream) 24%, transparent);
    }

    .tour-item[data-active] .tour-dot {
      background: var(--color-orange-bright);
    }

    .tour-body {
      color: color-mix(in srgb, var(--color-cream) 72%, transparent);
    }

    .showcase-figure figcaption,
    .compare-table thead th {
      color: color-mix(in srgb, var(--color-cream) 55%, transparent);
    }

    .compare-table th,
    .compare-table td {
      border-bottom-color: color-mix(in srgb, var(--color-cream) 12%, transparent);
    }

    .compare-table tbody th {
      color: var(--color-cream);
    }

    .compare-table td[data-status="included"] {
      color: var(--color-cream);
    }

    .compare-table td[data-status="included"] .compare-cue {
      background: var(--color-orange-bright);
    }

    .compare-table td[data-status="limited"] {
      color: color-mix(in srgb, var(--color-cream) 58%, transparent);
    }

    .compare-table td[data-status="limited"] .compare-cue {
      border-color: color-mix(in srgb, var(--color-cream) 40%, transparent);
    }

    .compare-table td[data-status="absent"] {
      color: color-mix(in srgb, var(--color-cream) 36%, transparent);
    }

    .compare-table td[data-status="absent"] .compare-cue {
      border-top-color: color-mix(in srgb, var(--color-cream) 32%, transparent);
    }
  }
</style>
