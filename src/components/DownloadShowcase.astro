---
import { Picture } from "astro:assets";
import DesktopClip from "./DesktopClip.astro";
import {
  desktopMediaStem,
  downloadShowcaseCopy,
} from "../lib/download-showcase";
import { isChineseHall, showGooglePlay, type ContentLocale } from "../lib/config";
import enCalendar from "../../assets/showcase/en/iphone-calendar.webp";
import enCountdown from "../../assets/showcase/en/iphone-countdown.webp";
import enWatch from "../../assets/showcase/en/iphone-watch.webp";
import enWidgets from "../../assets/showcase/en/iphone-widgets.webp";
import zhCalendar from "../../assets/showcase/zh-CN/iphone-calendar.webp";
import zhCountdown from "../../assets/showcase/zh-CN/iphone-countdown.webp";
import zhWatch from "../../assets/showcase/zh-CN/iphone-watch.webp";
import zhWidgets from "../../assets/showcase/zh-CN/iphone-widgets.webp";
import enAndroidBreaks from "../../assets/showcase/en/android-breaks.webp";
import enAndroidCalendar from "../../assets/showcase/en/android-calendar.webp";
import enAndroidLeave from "../../assets/showcase/en/android-leave.webp";
import enAndroidRecords from "../../assets/showcase/en/android-records.webp";
import zhAndroidBreaks from "../../assets/showcase/zh-CN/android-breaks.webp";
import zhAndroidCalendar from "../../assets/showcase/zh-CN/android-calendar.webp";
import zhAndroidLeave from "../../assets/showcase/zh-CN/android-leave.webp";
import zhAndroidRecords from "../../assets/showcase/zh-CN/android-records.webp";

interface Props {
  locale: ContentLocale;
}

const { locale } = Astro.props;
const copy = downloadShowcaseCopy(locale);
const stem = desktopMediaStem(locale);
// 3.2.0 iPhone 商店图（产品仓 scripts/marketing-shots/ios/out/creative-3.2.0，按 720 宽导出）。
const zh = isChineseHall(locale);
const iphoneShots = zh
  ? { countdown: zhCountdown, widgets: zhWidgets, calendar: zhCalendar, watch: zhWatch }
  : { countdown: enCountdown, widgets: enWidgets, calendar: enCalendar, watch: enWatch };
// Android 3.2.2 Google Play 商店图（真机 Debug 隔离包 + 合成数据，来源见 assets/showcase/android-sources.json）。
const androidShots = zh
  ? { calendar: zhAndroidCalendar, leave: zhAndroidLeave, records: zhAndroidRecords, breaks: zhAndroidBreaks }
  : { calendar: enAndroidCalendar, leave: enAndroidLeave, records: enAndroidRecords, breaks: enAndroidBreaks };
const tours = [
  {
    id: "download-iphone",
    heading: copy.iphoneHeading,
    lede: copy.iphoneLede,
    aspect: "720 / 1565",
    slides: copy.iphoneFeatures.map((feature) => ({ ...feature, src: iphoneShots[feature.shot] })),
  },
  ...(showGooglePlay
    ? [{
        id: "download-android",
        heading: copy.androidHeading,
        lede: copy.androidLede,
        aspect: "1080 / 1920",
        slides: copy.androidFeatures.map((feature) => ({ ...feature, src: androidShots[feature.shot] })),
      }]
    : []),
];
---

<section class="showcase" aria-label={copy.showcaseLabel}>
  <!-- 一个图位轮播四张商店图；四段说明始终可见（图上的标题搜索引擎读不到）。
       没有脚本时停在第一张；减少动态效果时不自动轮播，点选仍可切换。 -->
  {
    tours.map((tour) => (
      <section class="tour" aria-labelledby={tour.id} data-tour>
        <h2 id={tour.id} class="article-block-title showcase-compare-title">
          {tour.heading}
        </h2>
        <p class="article-sublede">{tour.lede}</p>
        <div class="tour-stage">
          <div class="tour-slot" id={`${tour.id}-shots`} style={`aspect-ratio:${tour.aspect}`}>
            {
              tour.slides.map((slide, index) => (
                <Picture
                  src={slide.src}
                  alt={slide.alt}
                  formats={["webp"]}
                  fallbackFormat="webp"
                  widths={[360, 720]}
                  sizes="(min-width: 880px) 20rem, 80vw"
                  loading="lazy"
                  decoding="async"
                  pictureAttributes={{
                    class: "tour-shot",
                    "data-tour-shot": String(index),
                    "data-active": index === 0 ? "" : undefined,
                    "aria-hidden": index === 0 ? undefined : "true",
                  }}
                />
              ))
            }
          </div>
          <ol class="tour-list">
            {
              tour.slides.map((slide, index) => (
                <li class="tour-item" data-tour-item={index} data-active={index === 0 ? "" : undefined}>
                  <span class="tour-dot" aria-hidden="true">0{index + 1}</span>
                  <div>
                    <h3 class="tour-title">
                      <button type="button" aria-controls={`${tour.id}-shots`} aria-pressed={index === 0 ? "true" : "false"}>
                        {slide.title}
                      </button>
                    </h3>
                    <p class="tour-body">{slide.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>
    ))
  }

  <section class="desktop-section" aria-labelledby="download-showcase">
  <h2 id="download-showcase" class="article-block-title">{copy.heading}</h2>
  <p class="article-sublede">{copy.lede}</p>

  <div class="showcase-stages">
    <div class="showcase-desk">
      <figure class="showcase-figure">
        <DesktopClip stem={stem} kind="app" alt={copy.appAlt} />
        <figcaption>{copy.desktopCaption}</figcaption>
      </figure>
      <figure class="showcase-figure">
        <DesktopClip stem={stem} kind="mini" alt={copy.miniAlt} />
        <figcaption>{copy.miniCaption}</figcaption>
      </figure>
    </div>
  </div>

  </section>

  <h2 id="download-compare" class="article-block-title showcase-compare-title">
    {copy.comparisonHeading}
  </h2>
  <p class="article-sublede">{copy.comparisonLede}</p>

  <div class="compare-everywhere">
    <p>{copy.everywhereLabel}</p>
    <ul>{copy.everywhere.map((feature) => <li>{feature}</li>)}</ul>
  </div>

  <div class="compare-wrap">
    <!-- Explicit roles keep the table semantics when narrow screens restyle the rows as grids. -->
    <table role="table" aria-labelledby="download-compare" class:list={["compare-table", showGooglePlay && "has-android"]} style={`--compare-cols:${showGooglePlay ? 3 : 2}`}>
      <thead role="rowgroup">
        <tr role="row">
          <th role="columnheader" scope="col">{copy.featureLabel}</th>
          <th role="columnheader" scope="col">{copy.mobileLabel}</th>
          {showGooglePlay && <th role="columnheader" scope="col">{copy.androidLabel}</th>}
          <th role="columnheader" scope="col">{copy.desktopLabel}</th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {
          copy.rows.map((row) => (
            <tr role="row">
              <th role="rowheader" scope="row">{row.feature}</th>
              {[row.mobile, ...(showGooglePlay ? [row.android] : []), row.desktop].map((cell) => (
                <td role="cell" data-status={cell.status}>
                  <span class="compare-cell">
                    <span class="compare-cue" aria-hidden="true"></span>
                    <span>{cell.detail}</span>
                  </span>
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<script is:inline>
  document.querySelectorAll("[data-tour]").forEach(function (tour) {
    if (!(tour instanceof HTMLElement)) return;
    var shots = tour.querySelectorAll("[data-tour-shot]");
    var items = tour.querySelectorAll("[data-tour-item]");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches || Boolean(navigator.connection && navigator.connection.saveData);
    var active = 0;
    var visible = false;
    var hovered = false;
    var focused = false;
    var paused = matchMedia("(prefers-reduced-motion: reduce)").matches;
    var timer = 0;

    function show(index) {
      active = index;
      shots.forEach(function (shot, i) {
        if (i === index) {
          shot.setAttribute("data-active", "");
          shot.removeAttribute("aria-hidden");
        } else {
          shot.removeAttribute("data-active");
          shot.setAttribute("aria-hidden", "true");
        }
      });
      items.forEach(function (item, i) {
        if (i === index) item.setAttribute("data-active", "");
        else item.removeAttribute("data-active");
        var button = item.querySelector("button");
        if (button) button.setAttribute("aria-pressed", i === index ? "true" : "false");
      });
      schedule();
    }

    // 每张停留 4.5 秒；只在看得见、没有悬停或焦点、没开减少动态效果时轮播。
    function schedule() {
      window.clearTimeout(timer);
      if (reduce || paused || hovered || focused || !visible || document.hidden) return;
      timer = window.setTimeout(function () {
        show((active + 1) % shots.length);
      }, 4500);
    }

    items.forEach(function (item, i) {
      item.addEventListener("click", function () {
        show(i);
      });
    });
    tour.addEventListener("mouseenter", function () {
      hovered = true;
      schedule();
    });
    tour.addEventListener("mouseleave", function () {
      hovered = false;
      schedule();
    });
    tour.addEventListener("focusin", function () {
      focused = true;
      schedule();
    });
    tour.addEventListener("focusout", function (event) {
      focused = tour.contains(event.relatedTarget);
      schedule();
    });

    document.addEventListener("doneat:media", function (event) { paused = event.detail.paused; reduce = matchMedia("(prefers-reduced-motion: reduce)").matches || Boolean(navigator.connection && navigator.connection.saveData); schedule(); });
    document.addEventListener("visibilitychange", schedule);
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        function (entries) {
          visible = Boolean(entries[0] && entries[0].isIntersecting);
          schedule();
        },
        { threshold: 0.4 },
      ).observe(tour.querySelector(".tour-slot"));
    }
  });
</script>

<script is:inline>
  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches || Boolean(navigator.connection && navigator.connection.saveData);
    var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;

    function loadClip(clip) {
      if (!(clip instanceof HTMLElement)) return;
      var video = clip.querySelector(dark ? "video.dark-scheme" : "video.light-scheme");
      if (reduce || document.documentElement.hasAttribute("data-demos-paused") || !(video instanceof HTMLVideoElement) || !video.dataset.src) return;
      if (video.querySelector("source")) return;
      var source = document.createElement("source");
      source.src = video.dataset.src;
      source.type = "video/mp4";
      video.appendChild(source);
      video.setAttribute("autoplay", "");
      video.preload = "metadata";
      video.addEventListener(
        "playing",
        function () {
          clip.classList.add("is-playing");
        },
        { once: true },
      );
      video.addEventListener("play", function () { if (document.documentElement.hasAttribute("data-demos-paused")) video.pause(); });
      video.load();
      var play = video.play();
      if (play && typeof play.catch === "function") play.catch(function () {});
    }

    var clips = document.querySelectorAll("[data-desktop-clip]");
    if (!clips.length) return;

    if (!("IntersectionObserver" in window)) {
      clips.forEach(loadClip);
      return;
    }

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          io.unobserve(entry.target);
          loadClip(entry.target);
        });
      },
      { rootMargin: "160px 0px", threshold: 0.01 },
    );
    document.addEventListener("doneat:media", function (event) { if (!event.detail.paused) { reduce = matchMedia("(prefers-reduced-motion: reduce)").matches || Boolean(navigator.connection && navigator.connection.saveData); clips.forEach(function (clip) { var r = clip.getBoundingClientRect(); if (r.bottom > 0 && r.top < innerHeight) loadClip(clip); }); } });
    clips.forEach(function (clip) {
      io.observe(clip);
    });
  })();
</script>

<style>
  .showcase { margin-top: 4.5rem; }
  .showcase-compare-title { margin-top: 0; }
  .tour-stage { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.4fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; margin-top: 2.5rem; }
  .tour + .tour { margin-top: 5rem; }
  .tour-slot { position: relative; width: 100%; max-width: 20rem; margin-inline: auto; overflow: hidden; border: 1px solid var(--rule); border-radius: 1.5rem; background: var(--surface); }
  .tour-slot :global(.tour-shot) { position: absolute; inset: 0; opacity: 0; transition: opacity 500ms var(--ease-out); }
  .tour-slot :global(.tour-shot[data-active]) { opacity: 1; }
  .tour-slot :global(.tour-shot img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .tour-list { display: grid; margin: 0; padding: 0; list-style: none; }
  .tour-item { display: flex; gap: 1rem; padding: 1.25rem 0; border-top: 1px solid var(--rule); }
  .tour-item:first-child { border-top: 0; }
  .tour-dot { flex: none; width: 1.3rem; margin-top: .7rem; color: var(--muted); font-size: .6875rem; font-variant-numeric: tabular-nums; }
  .tour-item[data-active] .tour-dot { color: var(--accent); }
  .tour-title { margin: 0; font-size: 1.15rem; font-weight: 600; line-height: 1.45; }
  .tour-title button { padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: start; min-height: 2.75rem; cursor: pointer; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: .3em; }
  .tour-item[data-active] .tour-title button { color: var(--accent); text-decoration-color: currentColor; }
  .tour-title button:hover { color: var(--accent); }
  .tour-body { margin: .1rem 0 0; color: var(--muted); font-size: .9375rem; line-height: 1.75; }
  .showcase-stages { margin-top: 2.5rem; }
  .showcase-desk { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 3rem; max-width: 56rem; margin-inline: auto; align-items: center; }
  .showcase-figure { margin: 0; min-width: 0; }
  .showcase-figure figcaption { min-height: 2.75rem; margin-top: .65rem; padding-block: .5rem; color: var(--muted); font-size: .75rem; line-height: 1.5; }
  /* Shared features are listed once; the table only carries differences. */
  .compare-everywhere { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem 1.25rem; margin-top: 1.75rem; }
  .compare-everywhere p { margin: 0; color: var(--muted); font-size: .8125rem; }
  .compare-everywhere ul { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; margin: 0; padding: 0; list-style: none; }
  .compare-everywhere li { display: inline-flex; align-items: baseline; gap: .45rem; font-size: .9375rem; font-weight: 500; }
  .compare-everywhere li::before { content: ""; flex: none; width: .5rem; height: .5rem; border-radius: 50%; background: var(--accent); transform: translateY(-.1em); }
  .compare-wrap { margin-top: 1.5rem; overflow-x: auto; }
  .compare-table { width: 100%; min-width: 34rem; border-collapse: collapse; table-layout: fixed; font-size: .9375rem; line-height: 1.45; }
  .compare-table th, .compare-table td { padding: .9rem .75rem; border-bottom: 1px solid var(--rule); text-align: start; vertical-align: top; }
  .compare-table :is(th, td):first-child { padding-inline-start: 0; }
  .compare-table thead th { padding-block: 0 .7rem; color: var(--muted); font-size: .8125rem; font-weight: 500; }
  .compare-table th:first-child { width: 22%; }
  .compare-table.has-android { min-width: 40rem; }
  .compare-table tbody th { font-weight: 500; color: var(--ink); }
  .compare-table tr:last-child :is(th, td) { border-bottom: 0; }
  .compare-cell { display: flex; align-items: flex-start; gap: .5rem; }
  .compare-cue { flex: none; box-sizing: border-box; margin-top: .42em; width: .5rem; height: .5rem; border-radius: 50%; }
  .compare-table td[data-status="included"] { color: var(--ink); }
  .compare-table td[data-status="included"] .compare-cue { background: var(--accent); }
  .compare-table td[data-status="limited"], .compare-table td[data-status="absent"] { color: var(--muted); }
  .compare-table td[data-status="limited"] .compare-cue { border: 1.5px solid var(--muted); }
  .compare-table td[data-status="absent"] .compare-cue { height: 0; margin-top: .72em; border-radius: 0; border-top: 1.5px solid var(--muted); }
  /* Phones: the feature name takes its own line and the platforms sit in
     columns beneath it, so the table reads without sideways scrolling. */
  @media (max-width: 639px) {
    .compare-table, .compare-table.has-android { display: block; min-width: 0; font-size: .875rem; }
    .compare-table :is(thead, tbody) { display: block; }
    .compare-table tr { display: grid; grid-template-columns: repeat(var(--compare-cols), minmax(0, 1fr)); gap: .4rem .75rem; padding-block: .85rem; border-bottom: 1px solid var(--rule); }
    .compare-table thead tr { padding-block: 0 .6rem; }
    .compare-table tr:last-child { border-bottom: 0; }
    .compare-table :is(th, td), .compare-table thead th, .compare-table th:first-child { width: auto; padding: 0; border: 0; }
    .compare-table thead th:first-child { display: none; }
    .compare-table tbody th { grid-column: 1 / -1; font-weight: 600; }
  }
  @media (max-width: 879px) {
    .tour-stage { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .tour-slot { max-width: 17rem; }
    .tour-list { max-width: 38rem; margin-inline: auto; }
    .showcase-desk { gap: 1.5rem; }
  }
  @media (max-width: 639px) {
    .showcase { margin-top: 3rem; }
    .showcase-desk { grid-template-columns: minmax(0, 1fr); }
    .showcase-desk .showcase-figure:last-child { max-width: 75%; margin-inline: auto; }
  }
  @media (prefers-reduced-motion: reduce) { .tour-slot :global(.tour-shot) { transition: none; } }
</style>
