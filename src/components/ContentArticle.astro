---
import DeviceHero from "./DeviceHero.astro";
import MediaControls from "./MediaControls.astro";
import DownloadShowcase from "./DownloadShowcase.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import StoreEntries from "./StoreEntries.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { downloadShowcaseCopy } from "../lib/download-showcase";
import { contentTrackPage } from "../lib/analytics-events";
import { canonicalUrl, siteConfig, type ContentLocale, type ContentPage, t } from "../lib/config";
import { faqPageJsonLd, parseFaqMarkdown } from "../lib/faq-jsonld";
import { downloadJsonLd } from "../lib/jsonld";
import { getEntry, render } from "astro:content";

interface Props {
  locale: ContentLocale;
  page: ContentPage;
}

const { locale, page } = Astro.props;
const entry = await getEntry("pages", `${locale}/${page}`);
if (!entry) {
  throw new Error(`Missing content: ${locale}/${page}`);
}
const { Content } = await render(entry);
const path = `/${locale}/${page}`;
const isFaq = page === "faq";
const isDownload = page === "download";
const hasBody = Boolean(entry.body?.trim());

// 商店徽章之外的次要入口：Chrome 扩展和 GitHub 安装包，只在系统要求下方给文字链接。
const otherDownloads = [
  entry.data.chromeExtensionLabel && entry.data.chromeExtensionNote
    ? {
        href: siteConfig.chromeWebStoreUrl,
        track: "chrome_extension_open",
        label: entry.data.chromeExtensionLabel,
        note: entry.data.chromeExtensionNote,
      }
    : null,
  entry.data.githubReleaseLabel && entry.data.githubReleaseNote
    ? {
        href: siteConfig.githubReleasesUrl,
        track: "github_releases_open",
        label: entry.data.githubReleaseLabel,
        note: entry.data.githubReleaseNote,
      }
    : null,
].filter((item) => item !== null);

const showcase = downloadShowcaseCopy(locale);
const jsonLd = isFaq
  ? faqPageJsonLd(parseFaqMarkdown(entry.body ?? ""), {
      locale,
      url: canonicalUrl(path),
    })
  : isDownload
    ? downloadJsonLd({
        path,
        title: entry.data.title,
        description: entry.data.description,
      })
    : undefined;
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  hreflangKind="content"
  jsonLd={jsonLd}
  trackPage={contentTrackPage(page)}
>
  <div class="flex min-h-screen flex-col">
    <SiteHeader locale={locale} currentPage={page} />
    <main
      id="content"
      class:list={["page-frame article", isDownload && "download-page"]}
    >
      <div class:list={[isDownload && "download-hero"]}>
        <div>
          <header class="article-head">
            <p class="article-kicker">
              {t(locale, page === "how-it-works" ? "howItWorks" : page)}
            </p>
            <h1 class="article-title">{entry.data.heading}</h1>
            {
              entry.data.updated ? (
                <p class="article-meta">
                  {entry.data.updatedLabel} {entry.data.updated}
                </p>
              ) : null
            }
            <p class="article-lede">{entry.data.intro}</p>
          </header>
          {
            isDownload ? (
              <div class="download-stores" id="get-app">
                <StoreEntries locale={locale} variant="download" />
              </div>
            ) : null
          }
        </div>
        {
          isDownload ? (
            <div class="download-device">
              <DeviceHero
                locale={locale}
                clip="review"
                priority
                alt={showcase.reviewAlt}
              />
              <MediaControls locale={locale} />
            </div>
          ) : null
        }
      </div>
      {
        isDownload ? (
          <nav
            class="download-index"
            aria-label={showcase.pageIndexLabel}
          >
            <a href="#download-iphone"><span>01</span> iPhone / Apple Watch</a>
            <a href="#download-showcase"><span>02</span> Mac / Windows</a>
            <a href="#download-compare">
              <span>03</span>
              {showcase.compareNavLabel}
            </a>
            <a href="#download-requirements">
              <span>04</span> {entry.data.requirementsHeading}
            </a>
          </nav>
        ) : null
      }
      {isDownload ? <DownloadShowcase locale={locale} /> : null}
      {
        isDownload && entry.data.nativePerks?.length ? (
          <section class="article-band native-band" aria-labelledby="native-heading">
            <h2 id="native-heading" class="article-block-title">
              {entry.data.nativeHeading}
            </h2>
            {
              entry.data.nativeLead ? (
                <p class="article-sublede">{entry.data.nativeLead}</p>
              ) : null
            }
            <ul class="native-perks">
              {entry.data.nativePerks.map((perk, index) => (
                <li class="native-perk">
                  <span class="perk-number" aria-hidden="true">0{index + 1}</span>
                  <h3 class="text-[0.98rem] font-semibold tracking-tight">{perk.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-plum/75 dark:text-cream/75">
                    {perk.body}
                  </p>
                </li>
              ))}
            </ul>
            {
              entry.data.nativeNote ? (
                <p class="mt-5 max-w-prose text-sm leading-relaxed text-plum/70 dark:text-cream/70">
                  {entry.data.nativeNote}
                </p>
              ) : null
            }
          </section>
        ) : null
      }
      {
        isDownload && entry.data.requirements?.length ? (
          <aside
            class="article-band requirements-band"
            aria-labelledby="download-requirements"
          >
            <h2
              id="download-requirements"
              class="text-xs font-semibold tracking-[0.04em] text-plum/65 dark:text-cream/65"
            >
              {entry.data.requirementsHeading}
            </h2>
            <ul class="mt-2 list-none space-y-1 p-0 text-sm leading-relaxed text-plum/70 dark:text-cream/70">
              {entry.data.requirements.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
            {
              otherDownloads.length ? (
                <ul class="mt-3 list-none space-y-1 border-t border-plum/10 p-0 pt-3 text-sm leading-relaxed text-plum/60 dark:border-cream/10 dark:text-cream/60">
                  {otherDownloads.map((item) => (
                    <li>
                      <a
                        class="text-inherit underline decoration-plum/25 underline-offset-4 hover:text-orange-ink hover:decoration-orange-ink dark:decoration-cream/25 dark:hover:text-orange-bright dark:hover:decoration-orange-bright"
                        href={item.href}
                        data-track={item.track}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {item.label}
                      </a>
                      <span> · {item.note}</span>
                    </li>
                  ))}
                </ul>
              ) : null
            }
          </aside>
        ) : null
      }
      {
        hasBody ? (
          <div
            class:list={["article-body", isFaq ? "faq-content" : "content"]}
          >
            <Content />
          </div>
        ) : null
      }
    </main>
    <SiteFooter locale={locale} />
  </div>
</BaseLayout>
