---
import DownloadShowcase from "./DownloadShowcase.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import StoreEntries from "./StoreEntries.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { contentTrackPage } from "../lib/analytics-events";
import { siteConfig, type ContentLocale, type ContentPage } from "../lib/config";
import { getEntry, render } from "astro:content";

interface Props {
  locale: ContentLocale;
  page: ContentPage;
}

const { locale, page } = Astro.props;
const entry = await getEntry("pages", `${locale}/${page}`);
if (!entry) {
  throw new Error(`Missing content: ${locale}/${page}`);
}
const { Content } = await render(entry);
const path = `/${locale}/${page}`;
const isFaq = page === "faq";
const isDownload = page === "download";
const hasBody = Boolean(entry.body?.trim());

const softwareJsonLd =
  isDownload
    ? {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: siteConfig.brandName,
        applicationCategory: "UtilitiesApplication",
        operatingSystem: "iOS, iPadOS, macOS, Windows, Web",
        url: `${siteConfig.officialSiteUrl}${path}`,
        image: `${siteConfig.officialSiteUrl}/icons/og-1200x630.png`,
        description: entry.data.description,
        author: {
          "@type": "Organization",
          name: siteConfig.brandName,
          url: siteConfig.officialSiteUrl,
          email: siteConfig.supportEmail,
        },
        downloadUrl: siteConfig.microsoftStoreUrl,
        installUrl: siteConfig.microsoftStoreUrl,
      }
    : undefined;
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  hreflangKind="content"
  jsonLd={softwareJsonLd}
  trackPage={contentTrackPage(page)}
>
  <div class="flex min-h-screen flex-col">
    <SiteHeader locale={locale} currentPage={page} />
    <main id="content" class="page-frame article">
      <header class="article-head">
        <h1 class="article-title">{entry.data.heading}</h1>
        {
          entry.data.updated ? (
            <p class="article-meta">
              {entry.data.updatedLabel} {entry.data.updated}
            </p>
          ) : null
        }
        <p class="article-lede">{entry.data.intro}</p>
      </header>
      {
        isDownload ? (
          <div class="article-measure mt-8">
            <StoreEntries locale={locale} variant="download" />
          </div>
        ) : null
      }
      {isDownload ? <DownloadShowcase locale={locale} /> : null}
      {
        isDownload && entry.data.nativePerks?.length ? (
          <section class="article-band mt-10" aria-labelledby="native-heading">
            <h2 id="native-heading" class="article-block-title">
              {entry.data.nativeHeading}
            </h2>
            {
              entry.data.nativeLead ? (
                <p class="article-sublede">{entry.data.nativeLead}</p>
              ) : null
            }
            <ul class="mt-6 grid w-full gap-3 sm:grid-cols-3">
              {entry.data.nativePerks.map((perk) => (
                <li class="rounded-2xl border border-plum/10 bg-plum/[0.035] p-4 dark:border-cream/12 dark:bg-cream/[0.05]">
                  <h3 class="text-[0.98rem] font-semibold tracking-tight">{perk.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-plum/75 dark:text-cream/75">
                    {perk.body}
                  </p>
                </li>
              ))}
            </ul>
            {
              entry.data.nativeNote ? (
                <p class="mt-5 max-w-prose text-sm leading-relaxed text-plum/70 dark:text-cream/70">
                  {entry.data.nativeNote}
                </p>
              ) : null
            }
          </section>
        ) : null
      }
      {
        isDownload && entry.data.requirements?.length ? (
          <aside
            class="article-band mt-8 w-full rounded-2xl border border-plum/10 bg-plum/[0.035] px-4 py-4 dark:border-cream/12 dark:bg-cream/[0.05]"
            aria-labelledby="download-requirements"
          >
            <h2
              id="download-requirements"
              class="text-xs font-semibold tracking-[0.04em] text-plum/65 dark:text-cream/65"
            >
              {entry.data.requirementsHeading}
            </h2>
            <ul class="mt-2 list-none space-y-1 p-0 text-sm leading-relaxed text-plum/70 dark:text-cream/70">
              {entry.data.requirements.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
            {
              entry.data.githubReleaseLabel && entry.data.githubReleaseNote ? (
                <p class="mt-3 border-t border-plum/10 pt-3 text-sm leading-relaxed text-plum/60 dark:border-cream/10 dark:text-cream/60">
                  <a
                    class="text-inherit underline decoration-plum/25 underline-offset-4 hover:text-orange-ink hover:decoration-orange-ink dark:decoration-cream/25 dark:hover:text-orange-bright dark:hover:decoration-orange-bright"
                    href={siteConfig.githubReleasesUrl}
                    data-track="github_releases_open"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {entry.data.githubReleaseLabel}
                  </a>
                  <span> · {entry.data.githubReleaseNote}</span>
                </p>
              ) : null
            }
          </aside>
        ) : null
      }
      {
        hasBody ? (
          <div
            class:list={["article-body", isFaq ? "faq-content" : "content"]}
          >
            <Content />
          </div>
        ) : null
      }
    </main>
    <SiteFooter locale={locale} />
  </div>
</BaseLayout>
