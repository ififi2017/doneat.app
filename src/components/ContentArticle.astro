---
import DeviceHero from "./DeviceHero.astro";
import MainlandAndroidEntry from "./MainlandAndroidEntry.astro";
import MediaControls from "./MediaControls.astro";
import DownloadShowcase from "./DownloadShowcase.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import StoreEntries from "./StoreEntries.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { downloadShowcaseCopy } from "../lib/download-showcase";
import { contentTrackPage } from "../lib/analytics-events";
import {
  contentLocaleFor,
  isChina,
  showGooglePlay,
  siteConfig,
  type ContentLocale,
  type ContentPage,
  t,
} from "../lib/config";
import { parseFaqMarkdown } from "../lib/faq-jsonld";
import {
  contentPageJsonLd,
  downloadJsonLd,
  faqGraphJsonLd,
  isoDateFromUpdated,
} from "../lib/jsonld";
import { getEntry, render } from "astro:content";

interface Props {
  locale: ContentLocale;
  page: ContentPage;
}

const { locale, page } = Astro.props;
const own = await getEntry("pages", `${locale}/${page}`);
// A route without its own file renders the English page in place. No redirect.
const entry = own ?? (await getEntry("pages", `en/${page}`));
if (!entry) {
  throw new Error(`Missing content: ${locale}/${page}`);
}
const { Content, headings } = await render(entry);
const path = own ? `/${locale}/${page}` : `/en/${page}`;
const isFaq = page === "faq";
const isDownload = page === "download";
const hasBody = Boolean(entry.body?.trim());
const tocHeadings = !isDownload ? headings.filter((heading) => heading.depth === 2) : [];
const showToc = tocHeadings.length >= 3;
const breadcrumbName =
  page === "terms"
    ? entry.data.heading
    : t(locale, page === "how-it-works" ? "howItWorks" : page);
const updatedIso = isoDateFromUpdated(entry.data.updated);

const relatedOrder = ["download", "how-it-works", "faq", "about", "privacy"] as const;
const relatedLinks = !isDownload
  ? relatedOrder
      .filter((item) => item !== page)
      .map((item) => ({
        href: `/${contentLocaleFor(locale, item)}/${item}`,
        label: t(locale, item === "how-it-works" ? "howItWorks" : item),
        primary: item === "download",
      }))
  : [];

// 商店徽章之外的次要入口：Chrome 扩展和 GitHub 安装包，只在系统要求下方给文字链接。
const otherDownloads = [
  entry.data.chromeExtensionLabel && entry.data.chromeExtensionNote
    ? {
        href: siteConfig.chromeWebStoreUrl,
        track: "chrome_extension_open",
        label: entry.data.chromeExtensionLabel,
        note: entry.data.chromeExtensionNote,
      }
    : null,
  entry.data.githubReleaseLabel && entry.data.githubReleaseNote
    ? {
        href: siteConfig.githubReleasesUrl,
        track: "github_releases_open",
        label: entry.data.githubReleaseLabel,
        note: entry.data.githubReleaseNote,
      }
    : null,
].filter((item) => item !== null);

const showcase = downloadShowcaseCopy(locale);
const jsonLd = isFaq
  ? faqGraphJsonLd(parseFaqMarkdown(entry.body ?? ""), {
      locale,
      path,
      title: entry.data.title,
      description: entry.data.description,
      breadcrumbName,
    })
  : isDownload
    ? downloadJsonLd({
        locale,
        path,
        title: entry.data.title,
        description: entry.data.description,
        breadcrumbName,
        requirements: entry.data.requirements,
      })
    : contentPageJsonLd({
        locale,
        path,
        page,
        title: entry.data.title,
        description: entry.data.description,
        breadcrumbName,
        updated: entry.data.updated,
      });
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  hreflangKind="content"
  jsonLd={jsonLd}
  trackPage={page === "terms" ? undefined : contentTrackPage(page)}
>
  <div class="flex min-h-screen flex-col">
    <SiteHeader locale={locale} currentPage={page} />
    <main
      id="content"
      class:list={["page-frame article", isDownload && "download-page"]}
    >
      <div class:list={[isDownload && "download-hero"]}>
        <div>
          <header class:list={["article-head", !isDownload && "article-head-ruled"]}>
            <p class="article-kicker">{breadcrumbName}</p>
            <h1 class="article-title">{entry.data.heading}</h1>
            {
              entry.data.updated ? (
                <p class="article-meta">
                  {entry.data.updatedLabel}{" "}
                  {updatedIso ? (
                    <time datetime={updatedIso}>{entry.data.updated}</time>
                  ) : (
                    entry.data.updated
                  )}
                </p>
              ) : null
            }
            <p class="article-lede">{entry.data.intro}</p>
          </header>
          {
            isDownload ? (
              <div class="download-stores" id="get-app">
                <StoreEntries locale={locale} variant="download" />
              </div>
            ) : null
          }
        </div>
        {
          isDownload ? (
            <div class="download-device">
              <DeviceHero
                locale={locale}
                clip="review"
                priority
                alt={showcase.reviewAlt}
              />
              <MediaControls locale={locale} />
            </div>
          ) : null
        }
      </div>
      {isDownload && !isChina && locale === "zh-CN" ? <MainlandAndroidEntry locale={locale} /> : null}
      {
        isDownload ? (
          <nav
            class="download-index"
            aria-label={showcase.pageIndexLabel}
          >
            <a href="#download-iphone"><span>01</span> iPhone / Apple Watch</a>
            {showGooglePlay && <a href="#download-android"><span>02</span> Android</a>}
            <a href="#download-showcase"><span>{showGooglePlay ? "03" : "02"}</span> Mac / Windows</a>
            <a href="#download-compare">
              <span>{showGooglePlay ? "04" : "03"}</span>
              {showcase.compareNavLabel}
            </a>
            <a href="#download-requirements">
              <span>{showGooglePlay ? "05" : "04"}</span> {entry.data.requirementsHeading}
            </a>
          </nav>
        ) : null
      }
      {isDownload ? <DownloadShowcase locale={locale} /> : null}
      {
        isDownload && entry.data.nativePerks?.length ? (
          <section class="article-band native-band" aria-labelledby="native-heading">
            <h2 id="native-heading" class="article-block-title">
              {entry.data.nativeHeading}
            </h2>
            {
              entry.data.nativeLead ? (
                <p class="article-sublede">{entry.data.nativeLead}</p>
              ) : null
            }
            <ul class="native-perks">
              {entry.data.nativePerks.map((perk, index) => (
                <li class="native-perk">
                  <span class="perk-number" aria-hidden="true">0{index + 1}</span>
                  <h3 class="native-perk-title">{perk.title}</h3>
                  <p class="native-perk-body">{perk.body}</p>
                </li>
              ))}
            </ul>
            {
              entry.data.nativeNote ? (
                <p class="native-note">{entry.data.nativeNote}</p>
              ) : null
            }
          </section>
        ) : null
      }
      {
        isDownload && entry.data.requirements?.length ? (
          <aside
            class="article-band requirements-band"
            aria-labelledby="download-requirements"
          >
            <h2 id="download-requirements" class="requirements-heading">
              {entry.data.requirementsHeading}
            </h2>
            <ul class="requirements-list">
              {entry.data.requirements.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
            {
              otherDownloads.length ? (
                <ul class="requirements-other">
                  {otherDownloads.map((item) => (
                    <li>
                      <a
                        class="requirements-link"
                        href={item.href}
                        data-track={item.track}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {item.label}
                      </a>
                      <span> · {item.note}</span>
                    </li>
                  ))}
                </ul>
              ) : null
            }
          </aside>
        ) : null
      }
      {
        hasBody ? (
          <div class:list={["article-layout", showToc && "has-toc"]}>
            {
              showToc ? (
                <details class="article-toc-mobile">
                  <summary>
                    <span>{entry.data.heading}</span>
                    <span class="article-toc-count" aria-hidden="true">{tocHeadings.length}</span>
                  </summary>
                  <nav aria-label={entry.data.heading}>
                    <ol>
                      {tocHeadings.map((heading, index) => (
                        <li>
                          <a href={`#${heading.slug}`}>
                            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                            <span>{heading.text}</span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  </nav>
                </details>
              ) : null
            }
            <div class:list={["article-body", isFaq ? "faq-content" : "content"]}>
              {isChina && page === "privacy" && <p>
                本页同时介绍 DoneAt 客户端与网站的隐私处理。国内官网 doneat.com.cn 托管于国内服务器，
                不启用下文所述的 Vercel Analytics；服务器会处理提供网页所需的连接信息。
                关于 doneat.app 和 off.rainif.com 的说明适用于对应网站。
              </p>}
              <Content />
            </div>
            {
              showToc ? (
                <aside class="article-toc" aria-label={entry.data.heading}>
                  <p class="article-toc-label">{breadcrumbName}</p>
                  <nav aria-label={entry.data.heading}>
                    <ol>
                      {tocHeadings.map((heading, index) => (
                        <li>
                          <a href={`#${heading.slug}`}>
                            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                            <span>{heading.text}</span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  </nav>
                </aside>
              ) : null
            }
          </div>
        ) : null
      }
      {
        relatedLinks.length ? (
          <nav class="article-related" aria-label={siteConfig.brandName}>
            {relatedLinks.map((item) => (
              <a
                class:list={["article-related-link", item.primary && "is-primary"]}
                href={item.href}
              >
                <span>{item.label}</span>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        ) : null
      }
    </main>
    <SiteFooter locale={locale} />
  </div>
</BaseLayout>
