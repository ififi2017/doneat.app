---
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import StoreEntries from "./StoreEntries.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig, type ContentLocale, type ContentPage } from "../lib/config";
import { getEntry, render } from "astro:content";

interface Props {
  locale: ContentLocale;
  page: ContentPage;
}

const { locale, page } = Astro.props;
const entry = await getEntry("pages", `${locale}/${page}`);
if (!entry) {
  throw new Error(`Missing content: ${locale}/${page}`);
}
const { Content } = await render(entry);
const path = `/${locale}/${page}`;

const softwareJsonLd =
  page === "download"
    ? {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: siteConfig.brandName,
        applicationCategory: "UtilitiesApplication",
        operatingSystem: "iOS, iPadOS, macOS, Windows, Web",
        url: `${siteConfig.officialSiteUrl}${path}`,
        image: `${siteConfig.officialSiteUrl}/icons/og-1200x630.png`,
        description: entry.data.description,
        author: {
          "@type": "Organization",
          name: siteConfig.brandName,
          url: siteConfig.officialSiteUrl,
          email: siteConfig.supportEmail,
        },
        downloadUrl: siteConfig.microsoftStoreUrl,
        installUrl: siteConfig.microsoftStoreUrl,
      }
    : undefined;
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  hreflangKind="content"
  jsonLd={softwareJsonLd}
>
  <div class="flex min-h-screen flex-col">
    <SiteHeader locale={locale} currentPage={page} />
    <main id="content" class="mx-auto w-full max-w-3xl flex-1 px-4 py-6 sm:px-6 sm:py-14">
      <h1 class="text-2xl font-semibold tracking-tight sm:text-4xl">
        {entry.data.heading}
      </h1>
      {
        entry.data.updated ? (
          <p class="mt-3 text-sm text-plum/60 dark:text-cream/55">
            {entry.data.updatedLabel} {entry.data.updated}
          </p>
        ) : null
      }
      <p class="mt-4 text-base leading-relaxed text-plum/80 dark:text-cream/80">
        {entry.data.intro}
      </p>
      {
        page === "download" ? (
          <div class="mt-8">
            <StoreEntries locale={locale} showWeb={false} />
            {
              entry.data.requirements?.length ? (
                <section class="mt-8 max-w-prose" aria-labelledby="download-requirements">
                  <h2
                    id="download-requirements"
                    class="text-xl font-semibold tracking-tight"
                  >
                    {entry.data.requirementsHeading}
                  </h2>
                  <ul class="mt-3 list-none space-y-2 p-0 text-base leading-relaxed text-plum/80 dark:text-cream/80">
                    {entry.data.requirements.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                </section>
              ) : null
            }
          </div>
        ) : null
      }
      <div class="content mt-8 max-w-prose text-base leading-relaxed">
        <Content />
      </div>
    </main>
    <SiteFooter locale={locale} />
  </div>
</BaseLayout>
