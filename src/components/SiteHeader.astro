---
import LocaleSwitch from "./LocaleSwitch.astro";
import {
  contentLocaleFor,
  siteConfig,
  t,
  webAppUrl,
  type ContentPage,
  type HallLocale,
} from "../lib/config";

interface Props {
  locale: HallLocale;
  currentPage?: ContentPage | "home";
  /** "dark" keeps the bar dark in both schemes (the homepage opens on black). */
  tone?: "auto" | "dark";
  domestic?: boolean;
}

const { locale, currentPage = "home", tone = "auto", domestic = false } = Astro.props;
function hrefFor(page: "download" | "faq" | "about"): string {
  return `/${contentLocaleFor(locale, page)}/${page}`;
}

const navItems = [
  {
    href: webAppUrl(locale, "header"),
    page: null,
    label: t(locale, "openTimer"),
    external: true,
    track: "web_timer_open",
  },
  { href: hrefFor("download"), page: "download", label: t(locale, "download"), external: false, track: null },
  { href: hrefFor("faq"), page: "faq", label: t(locale, "faq"), external: false, track: null },
  { href: hrefFor("about"), page: "about", label: t(locale, "about"), external: false, track: null },
] as const;

const linkIdle = "text-plum/80 dark:text-cream/80";
const linkActive = "text-orange-ink dark:text-orange-bright";
---

<header
  class:list={["site-header sticky top-0 z-40 pt-[env(safe-area-inset-top)]", tone === "dark" && "tone-dark"]}
>
  <div
    class="page-frame flex flex-nowrap items-center gap-3 py-1.5 sm:gap-4"
  >
    <a href={`/${locale}`} class="site-brand flex shrink-0 items-center gap-2 no-underline">
      <img
        class="site-brand-mark h-7 w-7 sm:h-8 sm:w-8 dark:hidden"
        src="/brand/off-work-countdown-mark.svg"
        width="32"
        height="32"
        alt=""
        aria-hidden="true"
      />
      <img
        class="site-brand-mark hidden h-7 w-7 sm:h-8 sm:w-8 dark:block"
        src="/brand/off-work-countdown-mark-dark.svg"
        width="32"
        height="32"
        alt=""
        aria-hidden="true"
      />
      <span class="text-base font-semibold tracking-tight">DoneAt</span>
    </a>

    <nav class="site-nav" aria-label="DoneAt">
      <a
        class="nav-github"
        href={siteConfig.githubUrl}
        data-track="github_source_open"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t(locale, "source")}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.54 0 0 1 12 6.844a9.54 9.54 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"
          ></path>
        </svg>
      </a>
      {
        navItems.map((item) => (
          <a
            class:list={[
              "site-nav-link shrink-0 whitespace-nowrap py-2 hover:text-orange-ink dark:hover:text-orange-bright",
              item.page && item.page === currentPage ? linkActive : linkIdle,
            ]}
            href={item.href}
            data-track={item.track ?? undefined}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            aria-current={item.page && item.page === currentPage ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ms-auto flex shrink-0 items-center gap-1.5 sm:gap-2">
      {domestic ? <a class="text-sm whitespace-nowrap" href="https://doneat.app/zh-CN">国际官网 ↗</a> : <LocaleSwitch locale={locale} currentPage={currentPage} />}
      <details class="nav-more header-panel relative" name="site-header-panel">
        <summary class="nav-more-summary" aria-label={t(locale, "navMenu")}>
          <span class="nav-more-bars" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </summary>
        <nav class="nav-more-menu header-panel-menu" aria-label="DoneAt">
          <a
            class="nav-more-link nav-more-github"
            href={siteConfig.githubUrl}
            data-track="github_source_open"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.54 0 0 1 12 6.844a9.54 9.54 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"
              ></path>
            </svg>
            {t(locale, "source")}
          </a>
          {
            navItems.map((item) => (
              <a
                class:list={[
                  "nav-more-link",
                  item.page && item.page === currentPage && "is-current",
                ]}
                href={item.href}
                data-track={item.track ?? undefined}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                aria-current={item.page && item.page === currentPage ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    /* Solid: a backdrop blur over the pinned homepage scenes paints stray
       compositing boxes in Chromium. */
    --header-surface: var(--tile);
    --header-control-bg: color-mix(in srgb, var(--tile) 85%, var(--paper));
    background: var(--paper);
    color: var(--ink);
    border-bottom: 1px solid color-mix(in srgb, var(--rule) 85%, transparent);
  }
  .site-header > .page-frame { min-height: 3.5rem; }
  .site-brand {
    border-radius: 0.5rem;
    transition: opacity 150ms ease;
  }
  .site-brand-mark {
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .site-brand:hover .site-brand-mark {
      transform: scale(1.06);
    }
  }
  .nav-github {
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: color-mix(in srgb, var(--color-plum) 78%, transparent);
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .nav-github:hover {
    color: var(--color-orange-ink);
    background: color-mix(in srgb, var(--color-orange) 10%, transparent);
  }

  .nav-github svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .site-nav {
    display: none;
    min-width: 0;
    flex: 1 1 0%;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .site-nav-link {
    position: relative;
    transition: color 150ms ease;
  }

  .site-nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    inset-inline: 0.1rem;
    bottom: 0.15rem;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
  }

  .nav-more {
    display: block;
  }

  @media (min-width: 1100px) {
    .site-nav {
      display: flex;
    }

    .nav-more {
      display: none;
    }
  }

  .nav-more-summary {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--color-plum) 15%, transparent);
    border-radius: 999px;
    background: var(--header-control-bg);
    color: inherit;
    cursor: pointer;
    list-style: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .nav-more-summary::-webkit-details-marker {
    display: none;
  }

  .nav-more-summary::marker {
    content: "";
  }

  .nav-more-summary:hover,
  .nav-more[open] .nav-more-summary {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .nav-more-summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .nav-more-bars {
    display: flex;
    width: 1.05rem;
    flex-direction: column;
    gap: 0.2rem;
  }

  .nav-more-bars span {
    display: block;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
    transition:
      transform 160ms ease,
      opacity 160ms ease;
  }

  .nav-more[open] .nav-more-bars span:nth-child(1) {
    transform: translateY(0.275rem) rotate(45deg);
  }

  .nav-more[open] .nav-more-bars span:nth-child(2) {
    opacity: 0;
  }

  .nav-more[open] .nav-more-bars span:nth-child(3) {
    transform: translateY(-0.275rem) rotate(-45deg);
  }

  .nav-more-menu {
    position: absolute;
    top: calc(100% + 0.45rem);
    inset-inline-end: 0;
    z-index: 50;
    display: flex;
    min-width: 14rem;
    max-width: min(20rem, calc(100vw - 2rem));
    flex-direction: column;
    gap: 0.1rem;
    overflow: auto;
    border: 1px solid color-mix(in srgb, var(--color-plum) 12%, transparent);
    border-radius: 1rem;
    background: var(--header-surface);
    padding: 0.375rem;
    box-shadow:
      0 4px 12px -4px color-mix(in srgb, var(--color-plum) 12%, transparent),
      0 20px 44px -18px color-mix(in srgb, var(--color-plum) 32%, transparent);
  }

  .nav-more-link {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: 0.65rem;
    padding: 0.55rem 0.8rem;
    color: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  .nav-more-github svg {
    width: 1.1rem;
    height: 1.1rem;
    margin-inline-end: 0.55rem;
  }

  .nav-more-link:hover {
    background: color-mix(in srgb, var(--color-orange) 11%, transparent);
  }

  .nav-more-link.is-current {
    background: color-mix(in srgb, var(--color-orange) 15%, transparent);
    color: var(--color-orange-ink);
    font-weight: 650;
  }

  @media (prefers-color-scheme: dark) {
    .site-header {
      --header-surface: #2a1f27;
      --header-control-bg: color-mix(in srgb, var(--color-evening-start) 55%, var(--paper));
    }

    .nav-more-summary {
      border-color: color-mix(in srgb, var(--color-cream) 16%, transparent);
    }

    .nav-more-menu {
      border-color: color-mix(in srgb, var(--color-cream) 14%, transparent);
      box-shadow:
        0 4px 16px -4px rgba(0, 0, 0, 0.35),
        0 22px 48px -16px rgba(0, 0, 0, 0.65);
    }

    .nav-more-link:hover,
    .nav-more-link.is-current {
      background: color-mix(in srgb, var(--color-orange-bright) 15%, transparent);
    }

    .nav-more-link.is-current {
      color: var(--color-orange-bright);
    }

    .nav-github {
      color: color-mix(in srgb, var(--color-cream) 82%, transparent);
    }

    .nav-github:hover {
      color: var(--color-orange-bright);
      background: color-mix(in srgb, var(--color-orange-bright) 14%, transparent);
    }
  }

  .site-header.tone-dark {
    --paper: #3d2a38;
    --ink: var(--color-cream);
    --rule: color-mix(in srgb, var(--color-cream) 12%, transparent);
    --accent: var(--color-orange-bright);
    --header-surface: #31212d;
    --header-control-bg: color-mix(in srgb, var(--color-evening-start) 72%, #231820);
    border-bottom-color: var(--rule);
  }

  :global(.tone-dark) .nav-more-summary {
    border-color: color-mix(in srgb, var(--color-cream) 18%, transparent);
  }

  :global(.tone-dark) .nav-more-menu {
    border-color: color-mix(in srgb, var(--color-cream) 14%, transparent);
    box-shadow:
      0 4px 16px -4px rgba(0, 0, 0, 0.35),
      0 22px 48px -16px rgba(0, 0, 0, 0.65);
  }

  :global(.tone-dark) .nav-more-link:hover, :global(.tone-dark) .nav-more-link.is-current {
    background: color-mix(in srgb, var(--color-orange-bright) 15%, transparent);
  }

  :global(.tone-dark) .nav-more-link.is-current {
    color: var(--color-orange-bright);
  }

  :global(.tone-dark) .nav-github {
    color: color-mix(in srgb, var(--color-cream) 82%, transparent);
  }

  :global(.tone-dark) .nav-github:hover {
    color: var(--color-orange-bright);
    background: color-mix(in srgb, var(--color-orange-bright) 14%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-brand,
    .site-brand-mark,
    .nav-github,
    .site-nav-link,
    .nav-more-summary,
    .nav-more-bars span,
    .nav-more-link {
      transition: none;
    }
    .site-brand:hover .site-brand-mark {
      transform: none;
    }
  }
</style>

<script is:inline>
  if (!document.documentElement.dataset.headerPanels) {
    document.documentElement.dataset.headerPanels = "1";
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      document.querySelectorAll("details.header-panel[open]").forEach((el) => {
        if (!el.contains(target)) el.removeAttribute("open");
      });
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      document.querySelectorAll("details.header-panel[open]").forEach((el) => {
        el.removeAttribute("open");
        var summary = el.querySelector("summary");
        if (summary) summary.focus();
      });
    });
  }
</script>
