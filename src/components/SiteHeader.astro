---
import LocaleSwitch from "./LocaleSwitch.astro";
import {
  contentLocaleFor,
  t,
  webAppUrl,
  type ContentPage,
  type HallLocale,
} from "../lib/config";

interface Props {
  locale: HallLocale;
  currentPage?: ContentPage | "home";
}

const { locale, currentPage = "home" } = Astro.props;
const contentLang = contentLocaleFor(locale);

function hrefFor(page: "download" | "faq" | "about"): string {
  return `/${contentLang}/${page}`;
}

const navItems = [
  { href: webAppUrl(locale), page: null, label: t(locale, "openTimer"), external: true },
  { href: hrefFor("download"), page: "download", label: t(locale, "download"), external: false },
  { href: hrefFor("faq"), page: "faq", label: t(locale, "faq"), external: false },
  { href: hrefFor("about"), page: "about", label: t(locale, "about"), external: false },
] as const;

const linkIdle = "text-plum/80 dark:text-cream/80";
const linkActive = "text-orange-ink dark:text-orange-bright";
---

<header
  class="sticky top-0 z-40 border-b border-plum/10 bg-cream/90 pt-[env(safe-area-inset-top)] backdrop-blur-md dark:border-cream/10 dark:bg-evening-end/80"
>
  <div
    class="mx-auto flex max-w-6xl flex-nowrap items-center gap-3 px-4 py-1.5 sm:gap-4 sm:px-6 sm:py-3"
  >
    <a href={`/${locale}`} class="flex shrink-0 items-center gap-2 no-underline">
      <img
        class="h-7 w-7 sm:h-8 sm:w-8 dark:hidden"
        src="/brand/off-work-countdown-mark.svg"
        width="32"
        height="32"
        alt=""
      />
      <img
        class="hidden h-7 w-7 sm:h-8 sm:w-8 dark:block"
        src="/brand/off-work-countdown-mark-dark.svg"
        width="32"
        height="32"
        alt=""
      />
      <span class="text-base font-semibold tracking-tight">DoneAt</span>
    </a>

    <nav class="site-nav" aria-label="DoneAt">
      {
        navItems.map((item) => (
          <a
            class:list={[
              "shrink-0 whitespace-nowrap py-2 hover:text-orange-ink dark:hover:text-orange-bright",
              item.page && item.page === currentPage ? linkActive : linkIdle,
            ]}
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            aria-current={item.page && item.page === currentPage ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ms-auto flex shrink-0 items-center gap-1.5 sm:gap-2">
      <LocaleSwitch locale={locale} currentPage={currentPage} />
      <details class="nav-more header-panel relative" name="site-header-panel">
        <summary class="nav-more-summary" aria-label={t(locale, "navMenu")}>
          <span class="nav-more-bars" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </summary>
        <nav class="nav-more-menu header-panel-menu" aria-label="DoneAt">
          {
            navItems.map((item) => (
              <a
                class:list={[
                  "nav-more-link",
                  item.page && item.page === currentPage && "is-current",
                ]}
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                aria-current={item.page && item.page === currentPage ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-nav {
    display: none;
    min-width: 0;
    flex: 1 1 0%;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    gap: 1.1rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .nav-more {
    display: block;
  }

  @media (min-width: 768px) {
    .site-nav {
      display: flex;
    }

    .nav-more {
      display: none;
    }
  }

  .nav-more-summary {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--color-plum) 14%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-cream) 88%, white);
    color: inherit;
    cursor: pointer;
    list-style: none;
  }

  .nav-more-summary::-webkit-details-marker {
    display: none;
  }

  .nav-more-summary::marker {
    content: "";
  }

  .nav-more-summary:hover,
  .nav-more[open] .nav-more-summary {
    border-color: color-mix(in srgb, var(--color-orange) 55%, transparent);
  }

  .nav-more-summary:focus-visible {
    outline: 2px solid var(--color-orange);
    outline-offset: 2px;
  }

  .nav-more-bars {
    display: flex;
    width: 1.05rem;
    flex-direction: column;
    gap: 0.2rem;
  }

  .nav-more-bars span {
    display: block;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
    transition:
      transform 160ms ease,
      opacity 160ms ease;
  }

  .nav-more[open] .nav-more-bars span:nth-child(1) {
    transform: translateY(0.275rem) rotate(45deg);
  }

  .nav-more[open] .nav-more-bars span:nth-child(2) {
    opacity: 0;
  }

  .nav-more[open] .nav-more-bars span:nth-child(3) {
    transform: translateY(-0.275rem) rotate(-45deg);
  }

  .nav-more-menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    inset-inline-end: 0;
    z-index: 50;
    display: flex;
    min-width: 14rem;
    max-width: min(20rem, calc(100vw - 2rem));
    flex-direction: column;
    overflow: auto;
    border: 1px solid color-mix(in srgb, var(--color-plum) 12%, transparent);
    border-radius: 0.9rem;
    background: var(--color-cream);
    padding: 0.35rem;
    box-shadow: 0 18px 40px -24px color-mix(in srgb, var(--color-plum) 55%, transparent);
  }

  .nav-more-link {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: 0.65rem;
    padding: 0.55rem 0.8rem;
    color: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
  }

  .nav-more-link:hover {
    background: color-mix(in srgb, var(--color-orange) 12%, transparent);
  }

  .nav-more-link.is-current {
    background: color-mix(in srgb, var(--color-orange) 16%, transparent);
    color: var(--color-orange-ink);
    font-weight: 650;
  }

  @media (prefers-color-scheme: dark) {
    .nav-more-summary {
      border-color: color-mix(in srgb, var(--color-cream) 18%, transparent);
      background: color-mix(in srgb, var(--color-evening-start) 88%, black);
    }

    .nav-more-menu {
      border-color: color-mix(in srgb, var(--color-cream) 14%, transparent);
      background: var(--color-evening-start);
      box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.55);
    }

    .nav-more-link:hover,
    .nav-more-link.is-current {
      background: color-mix(in srgb, var(--color-orange-bright) 16%, transparent);
    }

    .nav-more-link.is-current {
      color: var(--color-orange-bright);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-more-bars span {
      transition: none;
    }
  }
</style>

<script is:inline>
  if (!document.documentElement.dataset.headerPanels) {
    document.documentElement.dataset.headerPanels = "1";
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      document.querySelectorAll("details.header-panel[open]").forEach((el) => {
        if (!el.contains(target)) el.removeAttribute("open");
      });
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      document.querySelectorAll("details.header-panel[open]").forEach((el) => {
        el.removeAttribute("open");
      });
    });
  }
</script>
