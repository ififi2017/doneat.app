---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  appleBadgeLocale,
  appleStoreUrl,
  contentLocaleFor,
  microsoftBadgeLocale,
  siteConfig,
  t,
  webAppUrl,
  type HallLocale,
} from "../lib/config";

interface Props {
  locale: HallLocale;
  variant?: "home" | "download";
}

const appleBlackBadges = import.meta.glob<ImageMetadata>(
  "../../assets/badges/app-store/black/*.svg",
  { eager: true, import: "default" },
);
const appleWhiteBadges = import.meta.glob<ImageMetadata>(
  "../../assets/badges/app-store/white/*.svg",
  { eager: true, import: "default" },
);
const microsoftBadges = import.meta.glob<ImageMetadata>(
  "../../assets/badges/microsoft/*.svg",
  { eager: true, import: "default" },
);

function pickBadge(
  modules: Record<string, ImageMetadata>,
  file: string,
  fallback: string,
): ImageMetadata {
  const match = (name: string) =>
    Object.entries(modules).find(([key]) => key.endsWith(`/${name}`))?.[1];
  const found = match(file) ?? match(fallback);
  if (!found) {
    throw new Error(`Missing store badge: ${file}`);
  }
  return found;
}

const { locale, variant = "home" } = Astro.props;
const downloadHref = `/${contentLocaleFor(locale)}/download`;
const appleLocale = appleBadgeLocale(locale);
const msLocale = microsoftBadgeLocale(locale);
const appleHref = appleStoreUrl(locale);
const webHref = webAppUrl(locale);
const msHref = siteConfig.microsoftStoreUrl;
const isDownload = variant === "download";
const platformLine = isDownload
  ? `Windows · Mac · iPhone/iPad · Android (${t(locale, "comingSoon")})`
  : `${t(locale, "platformWeb")} · Windows · Mac · iPhone/iPad`;
const appleBlack = pickBadge(appleBlackBadges, `${appleLocale}.svg`, "en-us.svg");
const appleWhite = pickBadge(appleWhiteBadges, `${appleLocale}.svg`, "en-us.svg");
const msLight = pickBadge(
  microsoftBadges,
  `${msLocale}-light.svg`,
  "en-us-light.svg",
);
const msDark = pickBadge(
  microsoftBadges,
  `${msLocale}-dark.svg`,
  "en-us-dark.svg",
);
---

<div class="flex flex-col items-start gap-3">
  {
    isDownload ? null : (
      <div class="hall-cta-row">
        <a
          href={webHref}
          class="btn btn-secondary"
          data-track="web_timer_open"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t(locale, "webCta")}
        </a>
        <a
          href={downloadHref}
          class="btn btn-primary"
          data-track="download_page_open"
        >
          {t(locale, "downloadCta")}
        </a>
      </div>
    )
  }

  <div class="store-badges">
    <a href={appleHref} class="inline-block leading-none" data-track="app_store_open">
      <Image
        class="h-10 w-auto dark:hidden"
        src={appleBlack}
        alt={t(locale, "appStoreLabel")}
        height={40}
        inferSize
      />
      <Image
        class="hidden h-10 w-auto dark:block"
        src={appleWhite}
        alt={t(locale, "appStoreLabel")}
        height={40}
        inferSize
      />
    </a>
    <div class="ms-badge" data-track="microsoft_store_open">
      <a href={msHref} class="ms-fallback">
        <Image
          class="dark:hidden"
          src={msLight}
          alt={t(locale, "microsoftStoreLabel")}
          width={146}
          height={40}
        />
        <Image
          class="hidden dark:block"
          src={msDark}
          alt={t(locale, "microsoftStoreLabel")}
          width={146}
          height={40}
        />
      </a>
      <ms-store-badge
        productid={siteConfig.microsoftStoreId}
        productname={siteConfig.brandName}
        window-mode="full"
        theme="auto"
        language={msLocale}
        size="large"></ms-store-badge>
    </div>
  </div>

  <p class="hall-platforms">
    <span>{t(locale, "platformsLabel")}</span>
    {" "}
    {platformLine}
  </p>
</div>

<style>
  .hall-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .hall-cta-row + .store-badges {
    margin-top: 0.85rem;
  }

  .store-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
</style>

<script is:inline type="module" src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"
></script>
<script is:inline>
  (function () {
    function reveal(badge) {
      var wrap = badge.closest(".ms-badge");
      if (wrap) wrap.classList.add("is-loaded");
    }
    function watch(badge) {
      var root = badge.shadowRoot;
      var img = root && root.querySelector("img");
      if (img && img.complete && img.naturalWidth) {
        reveal(badge);
        return;
      }
      if (img) {
        img.addEventListener("load", function () {
          reveal(badge);
        }, { once: true });
      }
      window.setTimeout(function () {
        if (badge.shadowRoot && badge.shadowRoot.querySelector("img")) reveal(badge);
      }, 4000);
    }
    function attach() {
      document.querySelectorAll("ms-store-badge").forEach(watch);
    }
    if (window.customElements && customElements.whenDefined) {
      customElements.whenDefined("ms-store-badge").then(attach);
    } else {
      attach();
    }
  })();
</script>
