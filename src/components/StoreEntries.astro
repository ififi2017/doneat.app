---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  appleBadgeLocale,
  appleStoreUrl,
  contentLocaleFor,
  googlePlayBadgeLocale,
  microsoftBadgeLocale,
  showGooglePlay,
  isChina,
  siteConfig,
  t,
  webAppUrl,
  type HallLocale,
} from "../lib/config";

interface Props {
  locale: HallLocale;
  variant?: "home" | "download";
  /** "dark": both badges use their black artwork whatever the system scheme
      (the homepage finale sits on a fixed evening background). */
  tone?: "auto" | "dark";
}

const appleBlackBadges = import.meta.glob<ImageMetadata>(
  "../../assets/badges/app-store/black/*.svg",
  { eager: true, import: "default" },
);
const appleWhiteBadges = import.meta.glob<ImageMetadata>(
  "../../assets/badges/app-store/white/*.svg",
  { eager: true, import: "default" },
);
const googlePlayBadges = import.meta.glob<ImageMetadata>(
  "../../assets/badges/google-play/*.png",
  { eager: true, import: "default" },
);
const microsoftBadges = import.meta.glob<ImageMetadata>(
  "../../assets/badges/microsoft/*.svg",
  { eager: true, import: "default" },
);

function pickBadge(
  modules: Record<string, ImageMetadata>,
  file: string,
  fallback: string,
): ImageMetadata {
  const match = (name: string) =>
    Object.entries(modules).find(([key]) => key.endsWith(`/${name}`))?.[1];
  const found = match(file) ?? match(fallback);
  if (!found) {
    throw new Error(`Missing store badge: ${file}`);
  }
  return found;
}

const { locale, variant = "home", tone = "auto" } = Astro.props;
const fixedDark = tone === "dark";
const downloadHref = `/${contentLocaleFor(locale, "download")}/download`;
const appleLocale = appleBadgeLocale(locale);
const msLocale = microsoftBadgeLocale(locale);
const appleHref = appleStoreUrl(locale);
const webHref = webAppUrl(locale, "hall");
const msHref = siteConfig.microsoftStoreUrl;
const isDownload = variant === "download";
const appPlatforms = `Windows · Mac · iPhone/iPad${showGooglePlay || isChina ? " · Android" : ""}`;
const platformLine = isDownload
  ? appPlatforms
  : `${t(locale, "platformWeb")} · ${appPlatforms}`;
const appleBlack = pickBadge(appleBlackBadges, `${appleLocale}.svg`, "en-us.svg");
const appleWhite = pickBadge(appleWhiteBadges, `${appleLocale}.svg`, "en-us.svg");
const googlePlayBadge = pickBadge(
  googlePlayBadges,
  `${googlePlayBadgeLocale(locale)}.png`,
  "en.png",
);
const msLight = pickBadge(
  microsoftBadges,
  `${msLocale}-light.svg`,
  "en-us-light.svg",
);
const msDark = pickBadge(
  microsoftBadges,
  `${msLocale}-dark.svg`,
  "en-us-dark.svg",
);
const msBadgeHeight = 40;
const msBadgeWidth = Math.round((msBadgeHeight * msLight.width) / msLight.height);
---

<div class:list={["store-entries", isDownload && "is-download"]}>
  {
    isDownload ? null : (
      <div class="hall-cta-row">
        <a href={downloadHref} class="btn btn-primary" data-track="download_page_open">
          {t(locale, "downloadCta")}
        </a>
        <a
          href={webHref}
          class="btn btn-secondary"
          data-track="web_timer_open"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t(locale, "webCta")}
        </a>
      </div>
    )
  }

  <div class="store-badges">
    <a href={appleHref} class="inline-block leading-none" data-track="app_store_open">
      <Image
        class:list={["h-10 w-auto", !fixedDark && "dark:hidden"]}
        src={appleBlack}
        alt={t(locale, "appStoreLabel")}
        height={40}
        inferSize
      />
      {!fixedDark && (
        <Image
          class="hidden h-10 w-auto dark:block"
          src={appleWhite}
          alt={t(locale, "appStoreLabel")}
          height={40}
          inferSize
        />
      )}
    </a>
    {showGooglePlay && (
      <a
        href={siteConfig.googlePlayUrl}
        class="gp-badge inline-block leading-none"
        data-track="google_play_open"
      >
        <Image
          class="h-10 w-auto"
          src={googlePlayBadge}
          alt={t(locale, "googlePlayLabel")}
          height={40}
          densities={[1, 2, 3]}
          format="png"
          inferSize
        />
      </a>
    )}
    {isChina && (
      <a href="/android" class:list={["android-download-badge", fixedDark && "fixed-dark"]} aria-label="下载 Android 国内版">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5" />
        </svg>
        <span>Android 下载</span>
      </a>
    )}
    <a
      href={msHref}
      class="ms-badge"
      aria-label={t(locale, "microsoftStoreLabel")}
      data-track="microsoft_store_open"
      data-ms-width={msBadgeWidth}
      style={`width:${msBadgeWidth / 16}rem`}
    >
      <span class="ms-fallback" aria-hidden="true">
        {!fixedDark && (
          <Image
            class="dark:hidden"
            src={msLight}
            alt=""
            width={msBadgeWidth}
            height={msBadgeHeight}
          />
        )}
        <Image
          class:list={[!fixedDark && "hidden dark:block"]}
          src={msDark}
          alt=""
          width={msBadgeWidth}
          height={msBadgeHeight}
        />
      </span>
      <ms-store-badge
        inert
        aria-hidden="true"
        productid={siteConfig.microsoftStoreId}
        productname={siteConfig.brandName}
        window-mode="full"
        theme={fixedDark ? "dark" : "auto"}
        language={msLocale}
        size="large"></ms-store-badge>
    </a>
  </div>

  <p class="hall-platforms">
    <span>{t(locale, "platformsLabel")}</span>
    {" "}
    {platformLine}
  </p>
</div>

<style>
  .store-entries {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .hall-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .hall-cta-row + .store-badges {
    margin-top: 0.85rem;
  }

  .store-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .store-badges > a { padding-block: 2px; }
  /* Android visitors see their own store first (html[data-platform] is set in BaseLayout). */
  :global(html[data-platform="android"]) .gp-badge { order: -1; }
  .ms-badge { margin-block: 2px; }
  .store-badges > .android-download-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    height: 2.5rem;
    padding: 0 .8rem;
    margin-block: 2px;
    border: 1px solid #a6a6a6;
    border-radius: .35rem;
    background: #000;
    color: #fff;
    font-size: .9rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .android-download-badge:hover { opacity: .85; }
  .android-download-badge:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (prefers-color-scheme: dark) {
    .store-badges > .android-download-badge:not(.fixed-dark) { background: #fff; color: #000; }
  }

  @media (max-width: 879px) {
    .store-entries:not(.is-download) {
      align-items: center;
    }

    .store-entries:not(.is-download) .hall-cta-row,
    .store-entries:not(.is-download) .store-badges {
      justify-content: center;
    }

    .store-entries:not(.is-download) .hall-platforms {
      text-align: center;
    }
  }
</style>

<script is:inline type="module" src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"
></script>
<script is:inline>
  (function () {
    function fit(badge) {
      var wrap = badge.closest(".ms-badge");
      var img = badge.shadowRoot && badge.shadowRoot.querySelector("img");
      if (!wrap || !img || !img.naturalWidth || !img.naturalHeight) return false;
      img.style.height = "2.5rem";
      img.style.maxHeight = "2.5rem";
      img.style.width = "auto";
      // Widths in 16px units, written as rem so the badge scales with the grid.
      var fromImg = Math.round((40 * img.naturalWidth) / img.naturalHeight);
      var fromFallback = parseInt(wrap.getAttribute("data-ms-width"), 10) || 0;
      wrap.style.width = Math.max(fromImg, fromFallback) / 16 + "rem";
      wrap.classList.add("is-loaded");
      return true;
    }
    function watch(badge) {
      function tryFit() {
        fit(badge);
      }
      tryFit();
      var img = badge.shadowRoot && badge.shadowRoot.querySelector("img");
      if (img) {
        img.addEventListener("load", tryFit);
      }
      if (badge.shadowRoot && window.MutationObserver) {
        new MutationObserver(tryFit).observe(badge.shadowRoot, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ["src"],
        });
      }
      window.setTimeout(tryFit, 4000);
    }
    function attach() {
      document.querySelectorAll("ms-store-badge").forEach(watch);
    }
    if (window.customElements && customElements.whenDefined) {
      customElements.whenDefined("ms-store-badge").then(attach);
    } else {
      attach();
    }
  })();
</script>
