---
import {
  appleBadgeLocale,
  appleStoreUrl,
  microsoftBadgeLocale,
  siteConfig,
  t,
  webAppUrl,
  type HallLocale,
} from "../lib/config";

interface Props {
  locale: HallLocale;
  variant?: "home" | "download";
}

const { locale, variant = "home" } = Astro.props;
const appleLocale = appleBadgeLocale(locale);
const msLocale = microsoftBadgeLocale(locale);
const appleHref = appleStoreUrl(locale);
const webHref = webAppUrl(locale);
const msHref = siteConfig.microsoftStoreUrl;
const isDownload = variant === "download";
const platformLine = isDownload
  ? `Windows · Mac · iPhone/iPad · Android (${t(locale, "comingSoon")})`
  : `${t(locale, "platformWeb")} · Windows · Mac · iPhone/iPad`;
---

<div class="flex flex-col items-start gap-3">
  {
    isDownload ? null : (
      <a href={webHref} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
        {t(locale, "webCta")}
      </a>
    )
  }

  <div class="store-badges">
    <a href={appleHref} class="inline-block leading-none">
      <img
        class="h-10 w-auto dark:hidden"
        src={`/badges/app-store/black/${appleLocale}.svg`}
        alt={t(locale, "appStoreLabel")}
        height="40"
      />
      <img
        class="hidden h-10 w-auto dark:block"
        src={`/badges/app-store/white/${appleLocale}.svg`}
        alt={t(locale, "appStoreLabel")}
        height="40"
      />
    </a>
    <div class="ms-badge">
      <a href={msHref} class="ms-fallback">
        <img
          class="dark:hidden"
          src={`/badges/microsoft/${msLocale}-light.svg`}
          alt={t(locale, "microsoftStoreLabel")}
          width="146"
          height="40"
        />
        <img
          class="hidden dark:block"
          src={`/badges/microsoft/${msLocale}-dark.svg`}
          alt={t(locale, "microsoftStoreLabel")}
          width="146"
          height="40"
        />
      </a>
      <ms-store-badge
        productid={siteConfig.microsoftStoreId}
        productname={siteConfig.brandName}
        window-mode="full"
        theme="auto"
        language={msLocale}
        size="large"></ms-store-badge>
    </div>
  </div>

  <p class="max-w-md text-sm leading-relaxed text-plum/70 dark:text-cream/70">
    <span class="text-plum/70 dark:text-cream/70">{t(locale, "platformsLabel")}</span>
    {" "}
    {platformLine}
  </p>
</div>

<style>
  .store-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
</style>

<script is:inline type="module" src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"
></script>
<script is:inline>
  (function () {
    function reveal(badge) {
      var wrap = badge.closest(".ms-badge");
      if (wrap) wrap.classList.add("is-loaded");
    }
    function watch(badge) {
      var root = badge.shadowRoot;
      var img = root && root.querySelector("img");
      if (img && img.complete && img.naturalWidth) {
        reveal(badge);
        return;
      }
      if (img) {
        img.addEventListener("load", function () {
          reveal(badge);
        }, { once: true });
      }
      window.setTimeout(function () {
        if (badge.shadowRoot && badge.shadowRoot.querySelector("img")) reveal(badge);
      }, 4000);
    }
    function attach() {
      document.querySelectorAll("ms-store-badge").forEach(watch);
    }
    if (window.customElements && customElements.whenDefined) {
      customElements.whenDefined("ms-store-badge").then(attach);
    } else {
      attach();
    }
  })();
</script>
