---
import {
  CONTENT_LOCALES,
  HALL_LOCALES,
  localeNames,
  t,
  type ContentPage,
  type HallLocale,
} from "../lib/config";

interface Props {
  locale: HallLocale;
  currentPage?: ContentPage | "home";
}

const { locale, currentPage = "home" } = Astro.props;
const isContent = currentPage !== "home";
const locales = (isContent ? CONTENT_LOCALES : HALL_LOCALES) as readonly HallLocale[];

function hrefFor(code: string): string {
  if (isContent) return `/${code}/${currentPage}`;
  return `/${code}`;
}
---

<details class="locale-switch header-panel relative shrink-0" name="site-header-panel">
  <summary
    class="locale-switch-summary"
    aria-label={t(locale, "language")}
  >
    <span class="locale-switch-current" lang={locale}>{localeNames[locale]}</span>
    <svg
      class="locale-switch-chevron"
      width="12"
      height="12"
      viewBox="0 0 12 12"
      aria-hidden="true"
    >
      <path
        d="M2.4 4.2 6 7.8l3.6-3.6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </summary>
  <nav class="locale-switch-menu" aria-label={t(locale, "language")}>
    {
      locales.map((code) => (
        <a
          class:list={[
            "locale-switch-option",
            code === locale && "is-current",
          ]}
          href={hrefFor(code)}
          lang={code}
          hreflang={code}
          aria-current={code === locale ? "page" : undefined}
        >
          {localeNames[code]}
        </a>
      ))
    }
  </nav>
</details>

<style>
  .locale-switch-summary {
    display: inline-flex;
    max-width: 9rem;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid color-mix(in srgb, var(--color-plum) 14%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-cream) 88%, white);
    padding: 0.35rem 0.6rem 0.35rem 0.7rem;
    color: inherit;
    font-size: 0.875rem;
    line-height: 1.2;
    cursor: pointer;
    list-style: none;
  }

  .locale-switch-summary::-webkit-details-marker {
    display: none;
  }

  .locale-switch-summary::marker {
    content: "";
  }

  .locale-switch-current {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .locale-switch-chevron {
    flex-shrink: 0;
    opacity: 0.7;
    transition: transform 160ms ease;
  }

  .locale-switch[open] .locale-switch-chevron {
    transform: rotate(180deg);
  }

  .locale-switch-summary:hover,
  .locale-switch[open] .locale-switch-summary {
    border-color: color-mix(in srgb, var(--color-orange) 55%, transparent);
  }

  .locale-switch-summary:focus-visible {
    outline: 2px solid var(--color-orange);
    outline-offset: 2px;
  }

  @media (min-width: 640px) {
    .locale-switch-summary {
      max-width: 12.5rem;
      padding: 0.4rem 0.75rem 0.4rem 0.9rem;
    }
  }

  .locale-switch-menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    inset-inline-end: 0;
    z-index: 50;
    display: flex;
    min-width: 12.5rem;
    max-width: min(18rem, calc(100vw - 2rem));
    max-height: min(24rem, 70vh);
    flex-direction: column;
    overflow: auto;
    border: 1px solid color-mix(in srgb, var(--color-plum) 12%, transparent);
    border-radius: 0.9rem;
    background: var(--color-cream);
    padding: 0.35rem;
    box-shadow:
      0 18px 40px -24px color-mix(in srgb, var(--color-plum) 55%, transparent);
  }

  .locale-switch-option {
    border-radius: 0.65rem;
    padding: 0.65rem 0.75rem;
    color: inherit;
    font-size: 0.875rem;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
  }

  .locale-switch-option:hover {
    background: color-mix(in srgb, var(--color-orange) 12%, transparent);
  }

  .locale-switch-option.is-current {
    background: color-mix(in srgb, var(--color-orange) 16%, transparent);
    font-weight: 650;
  }

  @media (prefers-color-scheme: dark) {
    .locale-switch-summary {
      border-color: color-mix(in srgb, var(--color-cream) 18%, transparent);
      background: color-mix(in srgb, var(--color-evening-start) 88%, black);
    }

    .locale-switch-menu {
      border-color: color-mix(in srgb, var(--color-cream) 14%, transparent);
      background: var(--color-evening-start);
      box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.55);
    }

    .locale-switch-option:hover,
    .locale-switch-option.is-current {
      background: color-mix(in srgb, var(--color-orange-bright) 16%, transparent);
    }
  }
</style>

