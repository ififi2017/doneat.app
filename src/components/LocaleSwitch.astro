---
import {
  HALL_LOCALES,
  localeNames,
  publishedLocalesFor,
  t,
  type ContentPage,
  type HallLocale,
} from "../lib/config";

interface Props {
  locale: HallLocale;
  currentPage?: ContentPage | "home";
}

const { locale, currentPage = "home" } = Astro.props;
const isContent = currentPage !== "home";
const locales: readonly HallLocale[] =
  currentPage === "home" ? HALL_LOCALES : publishedLocalesFor(currentPage);

function hrefFor(code: string): string {
  if (isContent) return `/${code}/${currentPage}`;
  return `/${code}`;
}
---

{locales.length > 1 && <details class="locale-switch header-panel relative shrink-0" name="site-header-panel">
  <summary
    class="locale-switch-summary"
    aria-label={t(locale, "language")}
  >
    <span class="locale-switch-current" lang={locale}>{localeNames[locale]}</span>
    <svg
      class="locale-switch-chevron"
      width="12"
      height="12"
      viewBox="0 0 12 12"
      aria-hidden="true"
    >
      <path
        d="M2.4 4.2 6 7.8l3.6-3.6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </summary>
  <nav class="locale-switch-menu header-panel-menu" aria-label={t(locale, "language")}>
    {
      locales.map((code) => (
        <a
          class:list={[
            "locale-switch-option",
            code === locale && "is-current",
          ]}
          href={hrefFor(code)}
          lang={code}
          hreflang={code}
          aria-current={code === locale ? "page" : undefined}
        >
          {localeNames[code]}
        </a>
      ))
    }
  </nav>
</details>}

<style>
  .locale-switch-summary {
    display: inline-flex;
    max-width: 9rem;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid color-mix(in srgb, var(--color-plum) 15%, transparent);
    border-radius: 999px;
    background: var(--header-control-bg, color-mix(in srgb, var(--tile) 85%, var(--paper)));
    padding: 0.35rem 0.65rem 0.35rem 0.75rem;
    color: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    list-style: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .locale-switch-summary::-webkit-details-marker {
    display: none;
  }

  .locale-switch-summary::marker {
    content: "";
  }

  .locale-switch-current {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .locale-switch-chevron {
    flex-shrink: 0;
    opacity: 0.72;
    transition: transform 160ms var(--ease-out);
  }

  .locale-switch[open] .locale-switch-chevron {
    transform: rotate(180deg);
  }

  .locale-switch-summary:hover,
  .locale-switch[open] .locale-switch-summary {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .locale-switch-summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (min-width: 640px) {
    .locale-switch-summary {
      max-width: 12.5rem;
      padding: 0.4rem 0.8rem 0.4rem 0.95rem;
    }
  }

  .locale-switch-menu {
    position: absolute;
    top: calc(100% + 0.45rem);
    inset-inline-end: 0;
    z-index: 50;
    display: flex;
    min-width: 13.5rem;
    max-width: min(18rem, calc(100vw - 2rem));
    max-height: min(24rem, 70vh);
    flex-direction: column;
    gap: 0.1rem;
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid color-mix(in srgb, var(--color-plum) 12%, transparent);
    border-radius: 1rem;
    background: var(--header-surface, var(--tile));
    padding: 0.375rem;
    box-shadow:
      0 4px 12px -4px color-mix(in srgb, var(--color-plum) 12%, transparent),
      0 20px 44px -18px color-mix(in srgb, var(--color-plum) 32%, transparent);
  }

  .locale-switch-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-radius: 0.65rem;
    padding: 0.6rem 0.8rem;
    color: inherit;
    font-size: 0.875rem;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  .locale-switch-option:hover {
    background: color-mix(in srgb, var(--color-orange) 11%, transparent);
  }

  .locale-switch-option.is-current {
    background: color-mix(in srgb, var(--color-orange) 15%, transparent);
    color: var(--color-orange-ink);
    font-weight: 650;
  }

  .locale-switch-option.is-current::after {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: currentColor;
  }

  @media (prefers-color-scheme: dark) {
    .locale-switch-summary {
      border-color: color-mix(in srgb, var(--color-cream) 16%, transparent);
    }

    .locale-switch-menu {
      border-color: color-mix(in srgb, var(--color-cream) 14%, transparent);
      box-shadow:
        0 4px 16px -4px rgba(0, 0, 0, 0.35),
        0 22px 48px -16px rgba(0, 0, 0, 0.65);
    }

    .locale-switch-option:hover,
    .locale-switch-option.is-current {
      background: color-mix(in srgb, var(--color-orange-bright) 15%, transparent);
    }

    .locale-switch-option.is-current {
      color: var(--color-orange-bright);
    }
  }

  :global(.tone-dark) .locale-switch-summary {
    border-color: color-mix(in srgb, var(--color-cream) 18%, transparent);
  }

  :global(.tone-dark) .locale-switch-menu {
    border-color: color-mix(in srgb, var(--color-cream) 14%, transparent);
    box-shadow:
      0 4px 16px -4px rgba(0, 0, 0, 0.35),
      0 22px 48px -16px rgba(0, 0, 0, 0.65);
  }

  :global(.tone-dark) .locale-switch-option:hover,
  :global(.tone-dark) .locale-switch-option.is-current {
    background: color-mix(in srgb, var(--color-orange-bright) 15%, transparent);
  }

  :global(.tone-dark) .locale-switch-option.is-current {
    color: var(--color-orange-bright);
  }

  @media (prefers-reduced-motion: reduce) {
    .locale-switch-summary,
    .locale-switch-chevron,
    .locale-switch-option {
      transition: none;
    }
  }
</style>

