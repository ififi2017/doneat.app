---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  stem: "zh" | "en";
  kind: "app" | "mini";
  alt: string;
}

const stills = import.meta.glob<ImageMetadata>(
  "../../assets/desktop-demo/media/*.jpg",
  { eager: true, import: "default" },
);

function still(kind: "app" | "mini", stem: "zh" | "en", scheme: "light" | "dark") {
  const name = `${kind}-${stem}-${scheme}.jpg`;
  const found = Object.entries(stills).find(([key]) => key.endsWith(`/${name}`))?.[1];
  if (!found) {
    throw new Error(`Missing desktop still: ${name}`);
  }
  return found;
}

const { stem, kind, alt } = Astro.props;
const lightStill = still(kind, stem, "light");
const darkStill = still(kind, stem, "dark");
const lightVideo = `/desktop-demo/${kind}-${stem}-light.mp4`;
const darkVideo = `/desktop-demo/${kind}-${stem}-dark.mp4`;
const width = kind === "app" ? 860 : 600;
const height = kind === "app" ? 860 : 280;
---

<div class:list={["desk-clip", kind === "mini" && "is-mini"]} data-desktop-clip>
  <Image
    class="desk-still light-scheme"
    src={lightStill}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
  />
  <Image
    class="desk-still dark-scheme"
    src={darkStill}
    alt=""
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
  />
  <video
    class="desk-video light-scheme"
    data-src={lightVideo}
    muted
    loop
    playsinline
    preload="none"
    width={width}
    height={height}
    aria-hidden="true"></video>
  <video
    class="desk-video dark-scheme"
    data-src={darkVideo}
    muted
    loop
    playsinline
    preload="none"
    width={width}
    height={height}
    aria-hidden="true"></video>
</div>

<style>
  .desk-clip {
    position: relative;
    overflow: hidden;
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--color-plum) 8%, var(--color-cream));
    aspect-ratio: 1;
  }

  .desk-clip.is-mini {
    aspect-ratio: 15 / 7;
  }

  .desk-still,
  .desk-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .desk-video {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .desk-clip.is-playing .desk-video {
    opacity: 1;
  }

  .dark-scheme {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .desk-clip {
      background: color-mix(in srgb, var(--color-evening-end) 70%, black);
    }

    .light-scheme {
      display: none;
    }

    .dark-scheme {
      display: block;
    }
  }
</style>
