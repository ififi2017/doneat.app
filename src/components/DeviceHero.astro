---
import { Picture } from "astro:assets";
import enBlack from "../../assets/device/en-black.png";
import enWhite from "../../assets/device/en-white.png";
import frameBlue from "../../assets/device/frames/iphone-17-pro-max-deep-blue.png";
import frameOrange from "../../assets/device/frames/iphone-17-pro-max-cosmic-orange.png";
import zhBlack from "../../assets/device/zh-black.png";
import zhWhite from "../../assets/device/zh-white.png";
import { deviceStem, t, type HallLocale } from "../lib/config";

interface Props {
  locale: HallLocale;
}

const { locale } = Astro.props;
const stem = deviceStem(locale);
const alt = t(locale, "deviceAlt");
const still = stem === "zh" ? { white: zhWhite, black: zhBlack } : { white: enWhite, black: enBlack };
const sizes = "(min-width: 1024px) 24.5rem, (min-width: 640px) 20rem, 16.5rem";
const stillWidths = [360, 720, 1080];
const frameWidths = [400, 800, 1200];
---

<div class="device-hero relative mx-auto w-full max-w-[16.5rem] sm:max-w-[20rem] lg:max-w-[24.5rem]">
  <div class="device-screen">
    <Picture
      src={still.white}
      alt={alt}
      formats={["webp"]}
      widths={stillWidths}
      sizes={sizes}
      class="device-still light-scheme"
      pictureAttributes={{ class: "light-scheme" }}
      loading="eager"
      fetchpriority="high"
    />
    <Picture
      src={still.black}
      alt=""
      formats={["webp"]}
      widths={stillWidths}
      sizes={sizes}
      class="device-still dark-scheme"
      pictureAttributes={{ class: "dark-scheme" }}
      loading="lazy"
    />
    <video
      class="device-video light-scheme"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={`/device/${stem}-white.png`}
      width="1320"
      height="2868"
      aria-hidden="true"
    >
      <source src={`/device/${stem}-white.mp4`} type="video/mp4" />
    </video>
    <video
      class="device-video dark-scheme"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      poster={`/device/${stem}-black.png`}
      width="1320"
      height="2868"
      aria-hidden="true"
    >
      <source src={`/device/${stem}-black.mp4`} type="video/mp4" />
    </video>
  </div>
  <Picture
    src={frameOrange}
    alt=""
    formats={["webp"]}
    widths={frameWidths}
    sizes={sizes}
    pictureAttributes={{ class: "device-bezel light-scheme" }}
    class="light-scheme"
    loading="eager"
    aria-hidden="true"
  />
  <Picture
    src={frameBlue}
    alt=""
    formats={["webp"]}
    widths={frameWidths}
    sizes={sizes}
    pictureAttributes={{ class: "device-bezel dark-scheme" }}
    class="dark-scheme"
    loading="lazy"
    aria-hidden="true"
  />
</div>

<style>
  .device-hero {
    filter: drop-shadow(0 24px 50px color-mix(in srgb, var(--color-plum) 28%, transparent));
  }

  .device-screen {
    position: absolute;
    top: 2.2%;
    left: 5.102041%;
    width: 89.795918%;
    height: 95.6%;
    overflow: hidden;
    border-radius: 14.4% / 6.62%;
    background: #0a0a0a;
  }

  .device-screen :global(img),
  .device-screen video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .device-bezel {
    position: relative;
    z-index: 1;
    width: 100%;
    pointer-events: none;
    user-select: none;
  }

  .device-bezel :global(img) {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  @media (prefers-color-scheme: dark) {
    .device-hero {
      filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.5));
    }

    .light-scheme {
      display: none;
    }
  }

  @media (prefers-color-scheme: light) {
    .dark-scheme {
      display: none;
    }
  }
</style>
