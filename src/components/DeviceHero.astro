---
import { Picture } from "astro:assets";
import enBlack from "../../assets/device/en-black.png";
import enReview from "../../assets/device/en-review.png";
import enWhite from "../../assets/device/en-white.png";
import frameBlue from "../../assets/device/frames/iphone-17-pro-max-deep-blue.png";
import frameOrange from "../../assets/device/frames/iphone-17-pro-max-cosmic-orange.png";
import zhBlack from "../../assets/device/zh-black.png";
import zhReview from "../../assets/device/zh-review.png";
import zhWhite from "../../assets/device/zh-white.png";
import { deviceStem, t, type HallLocale } from "../lib/config";

interface Props {
  locale: HallLocale;
  priority?: boolean;
  clip?: "timer" | "review";
  alt?: string;
}

const { locale, priority = false, clip = "timer", alt: altOverride } = Astro.props;
const isReview = clip === "review";
const loading = priority ? "eager" : "lazy";
const fetchpriority = priority ? "high" : "auto";
const stem = deviceStem(locale);
const alt = altOverride ?? t(locale, "deviceAlt");
const still = stem === "zh" ? { white: zhWhite, black: zhBlack } : { white: enWhite, black: enBlack };
const reviewStill = stem === "zh" ? zhReview : enReview;
const reviewSrc = `/device/web/${stem}-review.mp4`;
const sizes = "(min-width: 880px) 18rem, (min-width: 640px) 17rem, 80vw";
const stillWidths = [360, 720, 1080];
const frameWidths = [400, 800, 1200];
---

<div
  class="device-hero relative mx-auto w-full max-w-[16.5rem] sm:max-w-[20rem] lg:max-w-[24.5rem]"
  data-device-hero
>
  <div class="device-screen">
    {
      isReview ? (
        <>
          <Picture
            src={reviewStill}
            alt={alt}
            formats={["webp"]}
            widths={stillWidths}
            sizes={sizes}
            class="device-still"
            loading={loading}
            fetchpriority={fetchpriority}
            decoding="async"
          />
          <video
            class="device-video"
            data-src={reviewSrc}
            muted
            loop
            playsinline
            preload="none"
            width="1320"
            height="2868"
            aria-hidden="true"
          ></video>
        </>
      ) : (
        <>
          <Picture
            src={still.white}
            alt={alt}
            formats={["webp"]}
            widths={stillWidths}
            sizes={sizes}
            class="device-still light-scheme"
            pictureAttributes={{ class: "light-scheme" }}
            loading={loading}
            fetchpriority={fetchpriority}
            decoding="async"
          />
          <Picture
            src={still.black}
            alt={alt}
            formats={["webp"]}
            widths={stillWidths}
            sizes={sizes}
            class="device-still dark-scheme"
            pictureAttributes={{ class: "dark-scheme" }}
            loading={loading}
            fetchpriority={fetchpriority}
            decoding="async"
          />
          <video
            class="device-video light-scheme"
            data-src={`/device/web/${stem}-white.mp4`}
            muted
            loop
            playsinline
            preload="none"
            width="1320"
            height="2868"
            aria-hidden="true"
          ></video>
          <video
            class="device-video dark-scheme"
            data-src={`/device/web/${stem}-black.mp4`}
            muted
            loop
            playsinline
            preload="none"
            width="1320"
            height="2868"
            aria-hidden="true"
          ></video>
        </>
      )
    }
  </div>
  <Picture
    src={frameOrange}
    alt=""
    formats={["webp"]}
    widths={frameWidths}
    sizes={sizes}
    pictureAttributes={{ class: "device-bezel light-scheme" }}
    class="light-scheme"
    loading={loading}
    fetchpriority={fetchpriority}
    aria-hidden="true"
  />
  <Picture
    src={frameBlue}
    alt=""
    formats={["webp"]}
    widths={frameWidths}
    sizes={sizes}
    pictureAttributes={{ class: "device-bezel dark-scheme" }}
    class="dark-scheme"
    loading={loading}
    fetchpriority={fetchpriority}
    aria-hidden="true"
  />
</div>

<script is:inline>
  (function () {
    var hero = document.querySelector("[data-device-hero]");
    if (!(hero instanceof HTMLElement)) return;

    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches || Boolean(navigator.connection && navigator.connection.saveData);
    var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    var still = hero.querySelector(
      dark ? "img.device-still.dark-scheme" : "img.device-still.light-scheme",
    ) || hero.querySelector("img.device-still");
    var video = hero.querySelector(
      dark ? "video.dark-scheme" : "video.light-scheme",
    ) || hero.querySelector("video.device-video");
    var ready = false;

    function markReady() {
      if (ready) return;
      ready = true;
      hero.classList.add("is-ready");
      hero.setAttribute("aria-busy", "false");
    }

    function stillReady() {
      return still instanceof HTMLImageElement && still.complete && still.naturalWidth > 0;
    }

    function onStill() {
      markReady();
    }

    if (still instanceof HTMLImageElement) {
      if (stillReady()) onStill();
      else still.addEventListener("load", onStill, { once: true });
    }

    function loadVideo() {
      if (reduce || !(video instanceof HTMLVideoElement) || !video.dataset.src) {
        if (stillReady()) markReady();
        return;
      }
      if (video.querySelector("source")) return;
      var source = document.createElement("source");
      source.src = video.dataset.src;
      source.type = "video/mp4";
      video.appendChild(source);
      video.setAttribute("autoplay", "");
      video.preload = "metadata";
      video.addEventListener("canplay", markReady, { once: true });
      video.addEventListener("playing", function () { hero.classList.add("is-video-playing"); });
      video.addEventListener("error", markReady, { once: true });
      video.addEventListener("play", function () {
        if (document.documentElement.hasAttribute("data-demos-paused")) video.pause();
      });
      video.load();
      var play = video.play();
      if (play && typeof play.catch === "function") play.catch(function () {});
      window.setTimeout(markReady, 5000);
    }

    if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(
        function (entries) {
          if (!entries[0] || !entries[0].isIntersecting) return;
          io.disconnect();
          loadVideo();
        },
        { rootMargin: "160px 0px", threshold: 0.01 },
      );
      io.observe(hero);
    } else {
      loadVideo();
    }
    document.addEventListener("doneat:media", function (event) {
      if (!event.detail.paused) { reduce = false; loadVideo(); }
    });
  })();
</script>

<style>
  .device-hero {
    isolation: isolate;
    filter: drop-shadow(0 24px 50px color-mix(in srgb, var(--color-plum) 28%, transparent));
  }

  .device-hero::after {
    content: "";
    position: absolute;
    inset: 16% 8% 10%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse at 50% 42%,
      color-mix(in srgb, var(--color-orange) 16%, transparent),
      transparent 70%
    );
  }

  .device-screen {
    position: absolute;
    top: 2.2%;
    left: 5.102041%;
    width: 89.795918%;
    height: 95.6%;
    overflow: hidden;
    border-radius: 14.4% / 6.62%;
    background: color-mix(in srgb, var(--color-plum) 18%, var(--color-cream));
  }

  .device-screen :global(img),
  .device-screen video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .device-video { opacity: 0; }
  .device-hero.is-video-playing .device-video { opacity: 1; }

  .device-bezel {
    position: relative;
    z-index: 1;
    width: 100%;
    pointer-events: none;
    user-select: none;
  }

  .device-bezel :global(img) {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  @media (prefers-color-scheme: dark) {
    .device-hero {
      filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.5));
    }

    .device-hero::after {
      background: radial-gradient(
        ellipse at 50% 42%,
        color-mix(in srgb, var(--color-orange-bright) 14%, transparent),
        transparent 72%
      );
    }

    .device-screen {
      background: color-mix(in srgb, var(--color-evening-end) 70%, black);
    }

    .light-scheme {
      display: none;
    }
  }

  @media (prefers-color-scheme: light) {
    .dark-scheme {
      display: none;
    }
  }

</style>
