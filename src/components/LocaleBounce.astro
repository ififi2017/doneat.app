---
import { siteConfig } from "../lib/config";

interface Props {
  script: string;
  links: { href: string; label: string }[];
}

const cream = siteConfig.colors.cream;
const eveningEnd = siteConfig.colors.eveningEnd;
const { script, links } = Astro.props;
const headHtml = `<style>
html,body{margin:0;min-height:100%;background:${cream}}
@media (prefers-color-scheme: dark){html,body{background:${eveningEnd}}}
</style><script>${script}</script>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>DoneAt</title>
    <Fragment set:html={headHtml} />
  </head>
  <body>
    <noscript>
      {
        links.map((link, index) => (
          <>
            {index > 0 ? " · " : null}
            <a href={link.href}>{link.label}</a>
          </>
        ))
      }
    </noscript>
  </body>
</html>
