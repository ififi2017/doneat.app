{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.doneat.app" }],
      "destination": "https://doneat.app/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/en"
    }
  ]
}
