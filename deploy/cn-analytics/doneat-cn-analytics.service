[Unit]
Description=DoneAt domestic anonymous daily event counters
After=network.target
[Service]
User=doneat-analytics
Group=doneat-analytics
StateDirectory=doneat-cn-analytics
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/doneat-cn-analytics/collector.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077
[Install]
WantedBy=multi-user.target
